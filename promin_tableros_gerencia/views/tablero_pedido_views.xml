<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tablero_pedido_search" model="ir.ui.view">
        <field name="name">view_tablero_pedido_search</field>
        <field name="model">promin.tablero.pedido</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="vendedor_id"/>
                <field name="linea_id"/>
                <field name="product_id"/>
                <filter name="sin_relacionadas" string="Sin empresas relacionadas" domain="[('es_relacionada', '=', False)]"/>
                <filter name="solo_relacionadas" string="Solo empresas relacionadas" domain="[('es_relacionada', '=', True)]"/>
                <separator/>
                <filter name="pend_entrega" string="Con entrega pendiente" domain="[('pendiente_entrega_usd', '&gt;', 0)]"/>
                <filter name="pend_facturar" string="Con facturación pendiente" domain="[('pendiente_facturar_usd', '&gt;', 0)]"/>
                <separator/>
                <filter name="t50k" string="Pedidos de 50K o más" domain="[('tramo', '=', '50k')]"/>
                <filter name="t20k" string="Pedidos de 20K a 50K" domain="[('tramo', '=', '20k')]"/>
                <separator/>
                <filter name="g_linea" string="Línea" context="{'group_by': 'linea_id'}"/>
                <filter name="g_sector" string="Sector" context="{'group_by': 'sector'}"/>
                <filter name="g_vendedor" string="Vendedor" context="{'group_by': 'vendedor_id'}"/>
                <filter name="g_cliente" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="g_integrador" string="Integrador" context="{'group_by': 'integrador'}"/>
                <filter name="g_tramo" string="Tramo del pedido" context="{'group_by': 'tramo'}"/>
                <filter name="g_semestre" string="Semestre" context="{'group_by': 'semestre'}"/>
                <filter name="g_mes" string="Mes del pedido" context="{'group_by': 'fecha:month'}"/>
                <filter name="g_mes_entrega" string="Mes de entrega" context="{'group_by': 'fecha_entrega:month'}"/>
            </search>
        </field>
    </record>
    <record id="view_tablero_pedido_list" model="ir.ui.view">
        <field name="name">view_tablero_pedido_list</field>
        <field name="model">promin.tablero.pedido</field>
        <field name="arch" type="xml">
            <list string="Pedidos (US$)" create="0" edit="0" delete="0">
                <field name="fecha"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="linea_id"/>
                <field name="sector"/>
                <field name="vendedor_id"/>
                <field name="pedido_usd" sum="Total"/>
                <field name="facturado_usd" sum="Total"/>
                <field name="pendiente_facturar_usd" sum="Total" optional="hide"/>
                <field name="pendiente_entrega_usd" sum="Total" optional="show"/>
                <field name="fecha_entrega" optional="show"/>
                <field name="tramo" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_tablero_pedido_pivot" model="ir.ui.view">
        <field name="name">view_tablero_pedido_pivot</field>
        <field name="model">promin.tablero.pedido</field>
        <field name="arch" type="xml">
            <pivot string="Pedidos por línea (US$)">
                <field name="linea_id" type="row"/>
                <field name="fecha" interval="month" type="col"/>
                <field name="pedido_usd" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_tablero_pedido_graph" model="ir.ui.view">
