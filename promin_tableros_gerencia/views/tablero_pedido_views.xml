            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="comprador_id"/>
                <field name="product_id"/>
                <filter name="rec_sin_fact" string="Recibido sin factura" domain="[('recibido_sin_factura_usd', '&gt;', 0.005)]"/>
                <filter name="fact_sin_ing" string="Facturado sin ingreso a almacén" domain="[('facturado_sin_ingreso_usd', '&gt;', 0.005)]"/>
                <filter name="fact_sin_pago" string="Facturado sin pagar" domain="[('facturado_sin_pago_usd', '&gt;', 0.005)]"/>
                <separator/>
                <filter name="g_proveedor" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                <filter name="g_linea" string="Línea" context="{'group_by': 'linea_id'}"/>
