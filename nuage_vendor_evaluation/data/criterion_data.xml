<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="criterion_quality" model="nuage.vendor.criterion">
        <field name="name">Calidad del producto</field>
        <field name="sequence">10</field>
        <field name="weight">30</field>
    </record>
    <record id="criterion_delivery" model="nuage.vendor.criterion">
        <field name="name">Cumplimiento de entregas</field>
        <field name="sequence">20</field>
        <field name="weight">30</field>
        <field name="is_delivery" eval="True"/>
    </record>
    <record id="criterion_price" model="nuage.vendor.criterion">
        <field name="name">Precio y condiciones de pago</field>
        <field name="sequence">30</field>
        <field name="weight">20</field>
    </record>
    <record id="criterion_service" model="nuage.vendor.criterion">
        <field name="name">Atención y servicio postventa</field>
        <field name="sequence">40</field>
        <field name="weight">20</field>
    </record>
</odoo>
