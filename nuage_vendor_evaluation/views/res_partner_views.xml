<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_nuage_evaluation" model="ir.ui.view">
        <field name="name">res.partner.form.nuage.evaluation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_nuage_evaluations" type="object" class="oe_stat_button"
                        icon="fa-star" groups="purchase.group_purchase_user">
                    <field name="nuage_evaluation_count" widget="statinfo" string="Evaluaciones"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
