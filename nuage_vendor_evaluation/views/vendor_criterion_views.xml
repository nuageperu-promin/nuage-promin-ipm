<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nuage_vendor_criterion_list" model="ir.ui.view">
        <field name="name">nuage.vendor.criterion.list</field>
        <field name="model">nuage.vendor.criterion</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="is_delivery"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_nuage_vendor_criterion" model="ir.actions.act_window">
        <field name="name">Criterios de evaluación</field>
        <field name="res_model">nuage.vendor.criterion</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
