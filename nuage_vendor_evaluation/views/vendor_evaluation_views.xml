<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nuage_vendor_evaluation_list" model="ir.ui.view">
        <field name="name">nuage.vendor.evaluation.list</field>
        <field name="model">nuage.vendor.evaluation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="rating == 'A' and state == 'confirmed'"
                  decoration-danger="rating == 'D' and state == 'confirmed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="on_time_rate" optional="show"/>
                <field name="total_score"/>
                <field name="rating" widget="badge"/>
                <field name="evaluator_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_nuage_vendor_evaluation_form" model="ir.ui.view">
        <field name="name">nuage.vendor.evaluation.form</field>
        <field name="model">nuage.vendor.evaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute_deliveries" type="object" string="Calcular entregas a tiempo"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Volver a borrador"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="evaluator_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="total_score"/>
                            <field name="rating" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Criterios" name="criteria">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="criterion_id" readonly="1" force_save="1"/>
                                    <field name="weight"/>
                                    <field name="score"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Entregas" name="deliveries">
                            <group>
                                <field name="deliveries_total"/>
                                <field name="deliveries_on_time"/>
                                <field name="on_time_rate"/>
                            </group>
                            <p class="text-muted">
                                Use el botón "Calcular entregas a tiempo" para contar las recepciones de compra
                                del período. Una recepción es "a tiempo" si se realizó en o antes de la fecha
                                prevista de la orden de compra.
                            </p>
                        </page>
                        <page string="Observaciones" name="notes">
                            <field name="notes" placeholder="Comentarios, acuerdos o acciones de mejora con el proveedor..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nuage_vendor_evaluation_search" model="ir.ui.view">
        <field name="name">nuage.vendor.evaluation.search</field>
        <field name="model">nuage.vendor.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="evaluator_id"/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmadas" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="rating_a" string="Categoría A" domain="[('rating', '=', 'A')]"/>
                <filter name="rating_d" string="Categoría D" domain="[('rating', '=', 'D')]"/>
                <group>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_rating" string="Categoría" context="{'group_by': 'rating'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'date_to:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_nuage_vendor_evaluation_pivot" model="ir.ui.view">
        <field name="name">nuage.vendor.evaluation.pivot</field>
        <field name="model">nuage.vendor.evaluation</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="date_to" interval="quarter" type="col"/>
                <field name="total_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_nuage_vendor_evaluation_graph" model="ir.ui.view">
        <field name="name">nuage.vendor.evaluation.graph</field>
        <field name="model">nuage.vendor.evaluation</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="partner_id"/>
                <field name="total_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_nuage_vendor_evaluation" model="ir.actions.act_window">
        <field name="name">Evaluación de proveedores</field>
        <field name="res_model">nuage.vendor.evaluation</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_nuage_vendor_evaluation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre su primera evaluación de proveedor</p>
            <p>Califique calidad, entregas, precio y servicio para saber con qué proveedores conviene trabajar.</p>
        </field>
    </record>
</odoo>
