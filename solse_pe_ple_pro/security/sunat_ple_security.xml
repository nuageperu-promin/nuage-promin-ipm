<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría del módulo -->
        <record model="ir.module.category" id="module_solse_pe_ple">
            <field name="name">PLE SUNAT</field>
            <field name="description">Libros Electrónicos PLE SUNAT</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilegios -->
        <record id="privilege_ple_usuario" model="res.groups.privilege">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_solse_pe_ple"/>
        </record>

        <record id="privilege_ple_gerente" model="res.groups.privilege">
            <field name="name">Gerente</field>
            <field name="category_id" ref="module_solse_pe_ple"/>
        </record>

        <!-- Grupos -->
        <record id="group_ple_usuario" model="res.groups">
            <field name="name">Usuario - PLE</field>
            <field name="privilege_id" ref="privilege_ple_usuario"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ple_gerente" model="res.groups">
            <field name="name">Gerente - PLE</field>
            <field name="privilege_id" ref="privilege_ple_gerente"/>
            <field name="implied_ids" eval="[(4, ref('group_ple_usuario'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Regla multi-empresa para reportes PLE -->
        <record id="ple_report_company_rule" model="ir.rule">
            <field name="name">Reportes PLE por empresa</field>
            <field name="model_id" ref="model_ple_report_templ"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
