<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<data>
	<template id="solse_pe_cpe_pdf_ee.cpe_body_print_m5">
		<t t-if="not company">
			<!-- Multicompany -->
			<t t-if="company_id">
				<t t-set="company" t-value="company_id"/>
			</t>
			<t t-elif="o and 'company_id' in o">
				<t t-set="company" t-value="o.company_id.sudo()"/>
			</t>
			<t t-else="else">
				<t t-set="company" t-value="res_company"/>
			</t>
		</t>
		<style>
			.nro-cpe {
				border: 0px solid #000 !important;
			}

			/* Solo la tabla externa lleva radius pequeño; las celdas NO,
			   para evitar el efecto festoneado en cada celda. */
			.tabla-n3 {
				border: 1px solid #a6a6a6 !important;
				border-radius: 4px;
				border-collapse: separate;
			}
			.tabla-n3 tr, .tabla-n3 td, .tabla-n3 th {
				border: 1px solid #a6a6a6 !important;
				border-radius: 0;
			}
			br {
				border: 0px;
			}
			.sinbordes, .sinbordes tr, .sinbordes td, .sinbordes th {
				border: 1px solid #fff !important;
			}
		</style>
		<!-- Header de wkhtmltopdf vacío: el contenido visual (logo + caja RUC)
		     se moverá al inicio del body. Razón: wkhtmltopdf renderiza el header
		     en un proceso separado con espacio limitado por (margin_top - header_spacing),
		     y la caja RUC de 130px solo se ve bien si hay logo (cuyo margin-top:-70px
		     arrastra todo el row hacia arriba). En empresas sin logo, la caja queda
		     aplastada. Moviéndolo al body, funciona siempre. -->
		<div class="header"></div>

		<div class="article o_report_layout_clean" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
			<t t-set="o" t-value="o.with_context(lang=lang)" />
			<div class="page">
				<h2>
					<span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura cancelada</span>
					<span t-if="o.move_type == 'out_invoice' and o.state == 'annul'">Factura anulada</span>
				</h2>
				<!-- Logo + Caja RUC (movido desde el header de wkhtmltopdf al body
				     para garantizar render correcto con o sin logo de company) -->
				<table style="width: 100%; border: 0px; margin-bottom: 8px;">
					<tr>
						<td style="width: 50%; border: 0px; text-align: center; vertical-align: middle; padding: 4px;">
							<img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
							     style="max-height: 130px; max-width: 450px;" alt="Logo" />
						</td>
						<td style="width: 50%; border: 0px; vertical-align: middle; padding: 4px;">
							<div style="font-size: 21px; height: 130px; border: 2px solid #a6a6a6 !important; border-radius: 5px; background: #dfdfdf; text-align: center;">
								<div style="padding-top: 22px;">
									<strong>RUC: <t t-esc="company.vat"/></strong>
									<br/>
									<strong>
										<t t-esc="o.pe_doc_name" />
										<br/>
									</strong>
									<strong>
										<t t-if="o.l10n_latam_document_number" t-esc="o.l10n_latam_document_number"/>
										<t t-else="" t-esc="o.name"/>
									</strong>
								</div>
							</div>
						</td>
					</tr>
				</table>
				<table style="width: 100%; border: 0px;">
					<tr>
						<td style="width: 50%; border: 0px; padding: 6px; vertical-align: top;">
							<strong><t t-esc="company.name"/></strong>
							<br/>
							<t t-esc="company.street"/>
							<br/>
							<br/>
							<t t-esc="company.partner_id.l10n_pe_district.name"/>,
							<t t-esc="company.state_id.name"/>,
							<t t-esc="company.city"/>
						</td>
						<td style="width: 50%; border: 2px solid #a6a6a6; border-radius: 5px; padding: 6px; vertical-align: top;">
							<strong>Fecha Emisión:</strong> <t t-esc="o.invoice_date"/>

							<br/>
							<strong>Señor(es):</strong><t t-esc="o.partner_id.display_name" style="word-wrap: break-word;"/>
							
							<br/>
							<strong><t t-if="o.partner_id.doc_type=='6'"> RUC: </t>
							<t t-else=""> DNI: </t></strong>
							<t t-esc="o.partner_id.doc_number"/>

							<br/>
							<strong>Dirección: </strong><t t-esc="o.partner_id.street" style="word-wrap: break-word;"/>

						</td>
					</tr>
				</table>
				<br/>
				<t t-set="tax_totals" t-value="o.tax_totals_pe"/>
				<div>
					<table class="tabla-n3" style="border: 2px solid #a6a6a6; border-radius: 0px; width: 100%;">
						<tr style="font-size: 13px;">
							
							
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Cant</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Unid</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Codigo</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Descripción</strong>
							</th>

							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Precio Unitario</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Dscto Unitario</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Valor Venta</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Tasa</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Impuesto</strong>
							</th>
							<th style="border: 2px solid #a6a6a6 !important; border-radius: 0px;">
								<strong>Precio Venta</strong>
							</th>
						</tr>

						<t t-set="current_subtotal" t-value="0"/>
						<t t-set="contador" t-value="0"/>
						<t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

						<t t-foreach="lines" t-as="line">
							<t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
							<t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

							<t t-if="line.display_type in ['product']">
								<t t-set="contador" t-value="contador + 1"/>
								<tr  style="border-left: 2px solid #a6a6a6 !important; font-size: 11px;" class="text-center">
									
									
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-esc="abs(line.quantity)"/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.product_uom_id"/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.product_id.default_code" t-options="{'widget': 'text'}"/> 
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<!-- Glosa sin código duplicado (Odoo prefija '[CODE]' en line.name) -->
										<span t-esc="line._obtener_glosa_pdf()" t-options="{'widget': 'text'}"/> 
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span class="text-nowrap" t-esc="abs(line.price_unit)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-esc="abs(line.amount_discount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-esc="abs(line.price_subtotal)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.tax_ids"/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<t t-set="monto_impuesto" t-value="abs(line.price_total - line.price_subtotal)" />
										<span class="text-nowrap" t-esc="monto_impuesto" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
									</td>
									<td style="border-left: 2px solid #a6a6a6 !important; padding: 3px;vertical-align: middle;">
										<span t-esc="abs(line.price_total)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
									</td>
								</tr>
							</t>

							<tr t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')" class="row">
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td> 
									<strong class="mr16">Subtotal</strong>
									<span
										t-esc="abs(current_subtotal)"
										t-options='{"widget": "monetary", "display_currency": o.currency_id}'
									/>
								</td>
							</tr>
						</t>
					</table>
					<!-- Bloque totales: usamos tabla HTML como contenedor para layout horizontal
					     estable en wkhtmltopdf (los <div class="row"> con <div class="col-X">
					     pueden apilarse verticalmente si el flexbox no aplica correctamente) -->
					<table style="width: 100%; border: 0px; margin-top: 4px;">
						<tr>
							<td style="width: 65%; border: 0px; vertical-align: top;"></td>
							<td style="width: 35%; border: 0px; vertical-align: top;">
								<!-- Desglose completo según observación 2 PDF - todos los importes en positivo -->
								<table class="tabla-n3" style="width: 100%; border-bottom: 2px solid #a6a6a6 !important; border-radius: 5px;">
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="width: 65%; padding: 2px 6px;">OP. GRAVADA</td>
										<td style="width: 35%; padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_taxable_amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">OP. INAFECTA</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_unaffected_amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">OP. EXONERADA</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_exonerated_amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">OP. EXPORTACIÓN</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_export_amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">OP. GRATUITA</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_free_amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">TOT. DSCTO.</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_amount_discount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<!-- ISC, IGV y otros impuestos desde tax_totals (Odoo 19) -->
									<t t-foreach="tax_totals['subtotals']" t-as="subtotal">
										<t t-foreach="subtotal['tax_groups']" t-as="tax_group">
											<tr style="border: 2px solid #a6a6a6 !important;">
												<td style="padding: 2px 6px;">
													<t t-out="tax_group['group_name']"/>
												</td>
												<td style="padding: 2px 6px; text-align: right;">
													<span t-out="tax_group['tax_amount_currency']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
												</td>
											</tr>
										</t>
									</t>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">OTROS CARGOS</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="abs(o.pe_charge_total)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important;">
										<td style="padding: 2px 6px;">OTROS TRIBUTOS</td>
										<td style="padding: 2px 6px; text-align: right;">
											<span t-esc="0.00" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</td>
									</tr>
									<tr style="border: 2px solid #a6a6a6 !important; font-weight: bold;">
										<td style="padding: 2px 6px;"><strong>IMPORTE TOTAL</strong></td>
										<td style="padding: 2px 6px; text-align: right;">
											<strong>
												<span t-esc="abs(o.amount_total_signed)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
											</strong>
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
					<br/>

					<!-- FACT-1b/1c: Documento que modifica y motivo (NC/ND) -->
					<t t-if="o.pe_invoice_code in ('07', '08')">
						<t t-set="label_origen" t-value="o._pe_obtener_label_doc_origen_pdf()"/>
						<t t-set="motivo_label" t-value="o._pe_obtener_motivo_nota_label()"/>
						<div style="border: 1px solid #000; border-radius: 5px; padding: 4px;" t-if="label_origen or motivo_label">
							<t t-if="label_origen">
								<strong t-if="o.pe_invoice_code == '07'">DOCUMENTO QUE MODIFICA: </strong>
								<strong t-if="o.pe_invoice_code == '08'">DOCUMENTO REFERENCIADO: </strong>
								<span t-esc="label_origen"/>
							</t>
							<br t-if="label_origen and motivo_label"/>
							<t t-if="motivo_label">
								<strong>MOTIVO: </strong>
								<span t-esc="motivo_label"/>
							</t>
						</div>
						<br t-if="label_origen or motivo_label"/>
					</t>

					<!-- FACT-3: Anticipos aplicados -->
					<t t-set="anticipos_aplicados" t-value="o._pe_obtener_anticipos_aplicados()"/>
					<div t-if="anticipos_aplicados" style="border: 1px solid #000; border-radius: 5px; padding: 4px;">
						<strong>ANTICIPOS APLICADOS:</strong>
						<table class="tabla-n3" style="width: 100%; margin-top: 3px;">
							<tr style="border: 1px solid #a6a6a6 !important; font-weight: bold; background: #f0f0f0;">
								<td style="padding: 2px 6px;">Tipo Operación</td>
								<td style="padding: 2px 6px;">Comprobante</td>
								<td style="padding: 2px 6px;">Fecha de pago</td>
								<td style="padding: 2px 6px; text-align: right;">Monto anticipado</td>
							</tr>
							<t t-foreach="anticipos_aplicados" t-as="anticipo">
								<tr style="border: 1px solid #a6a6a6 !important;">
									<td style="padding: 2px 6px;"><span t-esc="anticipo['tipo_operacion']"/></td>
									<td style="padding: 2px 6px;"><span t-esc="anticipo['comprobante']"/></td>
									<td style="padding: 2px 6px;"><span t-esc="anticipo['fecha_pago']"/></td>
									<td style="padding: 2px 6px; text-align: right;">
										<span t-esc="anticipo['monto']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
									</td>
								</tr>
							</t>
						</table>
					</div>
					<br t-if="anticipos_aplicados"/>

					<!-- FACT-2b: Cuentas bancarias para depósitos -->
					<t t-set="cuentas_bancarias" t-value="o._pe_obtener_cuentas_bancarias_pdf()"/>
					<div t-if="cuentas_bancarias" style="border: 1px solid #000; border-radius: 5px; padding: 4px;">
						<strong>CUENTAS:</strong>
						<table style="width: 100%; margin-top: 3px; font-size: 10px;">
							<t t-foreach="cuentas_bancarias" t-as="cuenta">
								<tr>
									<td style="padding: 1px 6px; border: 0px;">
										<span t-esc="cuenta['bank']"/>
										<t t-if="cuenta['moneda']"> - <span t-esc="cuenta['moneda']"/></t>
									</td>
									<td style="padding: 1px 6px; border: 0px;">
										CC: <span t-esc="cuenta['cc']"/>
									</td>
									<td style="padding: 1px 6px; border: 0px;" t-if="cuenta['cci']">
										CCI: <span t-esc="cuenta['cci']"/>
									</td>
								</tr>
							</t>
						</table>
					</div>
					<br t-if="cuentas_bancarias"/>

					<table style="width: 100%; border: 1px solid #000; border-radius: 4px;">
						<tr>
							<td style="width: 80%; border: 0px; padding: 4px; vertical-align: top;">
								<strong>IMPORTE EN LETRAS:</strong>
								<span t-field="o.amount_text" />
								<br/>
								<strong>RESUMEN:</strong>
								<span t-field="o.pe_digest" />
								<br/>
								<div t-if="o.is_cpe">
									Representación impresa de la factura electrónica
								</div>
							</td>
							<td style="width: 20%; border: 0px; text-align: right; padding: 3px; vertical-align: top;">
								<img t-if="o.is_cpe and o.sunat_qr_code"
								     t-att-src="image_data_uri(o.sunat_qr_code)"
								     style="width: 90px; height: 90px;"
								     alt="QR"/>
							</td>
						</tr>
					</table>
					<div style="border: 1px solid #000; border-radius: 5px; padding: 4px; margin-top: 2px;">
						<strong>OBSERVACIÓN:</strong>
						<span t-field="o.narration" />
						<strong>VENDEDOR:</strong>
						<span t-field="o.invoice_user_id" />
					</div>
					<br/>
					<div  t-if="o.tiene_detraccion" >
						<div style="border: 1px solid #000 !important; border-radius: 2px; width: 100%;" t-if="o.tiene_detraccion and company.cuenta_detraccion and company.cuenta_detraccion.bank_account_id">
							Operación sujeta a Detracción
							<br/>
							Operación Sujeta a Sistema de Pago de Obligaciones Tributarias con el Gobierno Central D. Leg. 940 - <t t-esc="o.porc_detraccion"/> % (S/ <span class="text-nowrap" t-esc="'%.2f'%(o.monto_detraccion)"/> )
							<br/>
							<div class="col-3 text-left" t-if="o.move_type == 'out_invoice'"> 
								<span style="font-weight: bold;" t-esc="company.cuenta_detraccion.name"/>
							</div>
							<div class="text-right o_price_total" t-if="o.move_type == 'out_invoice'"> 
								<span class="text-nowrap"> <t t-esc="company.cuenta_detraccion.bank_account_id.acc_number"/> </span> 
							</div>
						</div>
					</div>

					<div  t-if="o.tiene_retencion">
						Operación sujeta a Retencion
						<div style="border: 1px solid #000 !important; border-radius: 2px; width: 100%;">
							<div class="text-right o_price_total"> 
								Retencion: 
								<t t-esc="o.currency_id.symbol"/><span class="text-nowrap" t-esc="'%.2f'%(o.monto_retencion)"/>  (<t t-esc="o.porc_retencion"/> %)
							</div>

							<div class="text-right o_price_total"> 
								Neto a Pagar: 
								<t t-esc="o.currency_id.symbol"/>
								<t t-if="o.currency_id.id == o.company_id.currency_id.id">
									<span class="text-nowrap" t-esc="'%.2f'%(o.monto_neto_pagar)"/> 
								</t>
								<t t-else="">
									<span class="text-nowrap" t-esc="'%.2f'%(o.monto_neto_pagar_base)"/> 
								</t>
							</div>
						</div>
					</div>

				</div>
				Forma Pago:
				<t t-if="o.tipo_transaccion" t-esc="dict(o.fields_get(allfields=['tipo_transaccion'])['tipo_transaccion']['selection'])[o.tipo_transaccion]"/> 
				<t t-else="">
					CONTADO
				</t>
				<div t-if="o.tipo_transaccion == 'credito' ">
					<br/>
					 <table style="border: 1px solid #ddd !important; border-radius: 6px; width: 75%;margin: 0 auto;"  >
						<thead>
							<tr> 
								<td class="cpe-gris">Nº DE CUOTA</td>
								<td class="cpe-gris">IMPORTE</td>
								<td class="cpe-gris">FECHA DE PAGO</td>
							</tr>
						</thead>
						<tbody style="border: 0px;margin: 0px; padding: 0px;">
							<t t-set="contador" t-value="0"/>
							<t t-foreach="o.obtener_cuotas_pago()" t-as="cuota">
								<t t-set="contador" t-value="contador + 1"/>
								<tr style="margin: 0px; padding: 0px;">
									<td class="td-n1" style="border: 0px;margin: 0px; padding: 0px;">Cuota<t t-esc="'{0:03d}'.format(contador)"/></td>
									<td class="td-n1" style="border: 0px;margin: 0px; padding: 0px;"><span t-esc="'%.2f'%(cuota['amount'])"/></td>
									<td class="td-n1" style="border: 0px;margin: 0px; padding: 0px;"><span t-esc="cuota['date_maturity']"/></td>
								</tr>
							</t>
							
						</tbody>
					 </table>
				</div>
				<!--<p t-if="o.invoice_payment_term_id" name="payment_term">
					<span t-field="o.invoice_payment_term_id.note"/>
				</p>-->
				<p t-if="o.fiscal_position_id.note" name="note">
					<span t-field="o.fiscal_position_id.note"/>
				</p>
				<div id="qrcode" t-if="(o.company_id.qr_code) and (o.currency_id.name == 'EUR') and (o.invoice_partner_bank_id.acc_number != False)">
					<p t-if="(o.invoice_partner_bank_id.qr_code_valid)">
						<strong class="text-center">Scan me with your banking app.</strong><br /><br />
						<img class="border border-dark rounded" t-att-src="o.invoice_partner_bank_id.build_qr_code_url(o.amount_residual, o.invoice_payment_ref or o.ref or o.name)"/>
					</p>
					<p t-if="(o.invoice_partner_bank_id.qr_code_valid == False)">
						<strong class="text-center">The SEPA QR Code informations are not set correctly.</strong><br />
					</p>
				</div>
			</div>
			<div class="col-xs-12" t-if="o.is_cpe" style="padding: 2mm">

				<!--<img t-if="o.sunat_qr_code" t-att-src="'data:image/png;base64,%s' %to_text(o.sunat_qr_code)" class="img-responsive center-block" style="width: 40mm;  height: 40mm;" />-->

				
			</div>

		</div>
		
		<div class="footer" >
			<br/>
			<div class="text-center" style="border-top: 1px solid black;">
				<ul class="list-inline mb4">
					<li t-if="company.phone">Telefono: 
						<span t-field="company.phone"/></li>
					<li t-if="company.email">Email: 
						<span t-field="company.email"/></li>
					<li t-if="company.website">Web: <span t-field="company.website"/></li>

					<!--<li t-if="company.website">
						Representación impresa de factura electrónica, consulta en <span t-field="company.website"/></li>-->
				</ul>
				<!--<div name="financial_infos">
					<span t-field="company.report_footer"/>
				</div>-->
				<div class="text-muted">
					<span class="page"/>
					de  
					<span class="topage"/></div>
			</div>
			
			<br/>
		</div>
	</template>

	<template id="solse_pe_cpe_pdf_ee.report_invoice_with_payments_m5">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
				<t t-call="solse_pe_cpe_pdf_ee.cpe_body_print_m5" t-lang="lang"/>
			</t>
		</t>
	</template>

	<record id="report_cpe_sunat_plantilla_5" model="ir.actions.report">
		<field name="name">Factura (Formato 5)</field>
		<field name="model">account.move</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">solse_pe_cpe_pdf_ee.report_invoice_with_payments_m5</field>
		<field name="report_file">solse_pe_cpe_pdf_ee.report_invoice_with_payments_m5</field>
		<field name="binding_model_id" ref="account.model_account_move"/>
		<field name="binding_type">report</field>
	</record>

	<record id="solse_pe_cpe_pdf_ee.paperformat_factura_n5" model="report.paperformat">
		<field name="name">Factura (Plantilla 5)</field>
		<field name="default" eval="True" />
		<field name="format">custom</field>
		<field name="page_height">297</field>
		<field name="page_width">210</field>
		<field name="orientation">Portrait</field>
		<!-- El header (logo + caja RUC) ahora vive dentro del body, no del header
		     de wkhtmltopdf. Por eso el margen arriba puede ser estándar (10mm).
		     header_spacing=0 porque el div.header está vacío. -->
		<field name="margin_top">10</field>
		<field name="header_spacing">0</field>
		<field name="margin_bottom">30</field>
		<field name="margin_left">7</field>
		<field name="margin_right">7</field>
		<field name="header_line" eval="False" /><!-- mostrar una linea en cabecera-->
		<field name="dpi">90</field>
	</record>


	<record id="solse_pe_cpe_pdf_ee.report_cpe_sunat_plantilla_5" model="ir.actions.report">
		<field name="paperformat_id" ref="solse_pe_cpe_pdf_ee.paperformat_factura_n5"/>
	</record>

</data>
