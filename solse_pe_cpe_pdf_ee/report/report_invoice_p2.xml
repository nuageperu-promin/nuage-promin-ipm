<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<data>
	<template id="solse_pe_cpe_pdf_ee.cpe_body_print">
		<t t-if="not company">
			<!-- Multicompany -->
			<t t-if="company_id">
				<t t-set="company" t-value="company_id"/>
			</t>
			<t t-elif="o and 'company_id' in o">
				<t t-set="company" t-value="o.company_id.sudo()"/>
			</t>
			<t t-else="else">
				<t t-set="company" t-value="res_company"/>
			</t>
		</t>
		<style>
			.nro-cpe {
				border: 2px solid #000 !important;
			}

			.tabla-n3, .tabla-n3 tr, .tabla-n3 td, .tabla-n3 th {
				border: 1px solid #000 !important;
			}
		</style>
		<!-- Header de wkhtmltopdf vacío: el contenido (logo + empresa + caja RUC) se
		     movió al inicio del body para que funcione con o sin logo de company. -->
		<div class="header"></div>

		<div class="article o_report_layout_clean factura" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
			<t t-set="o" t-value="o.with_context(lang=lang)" />
			<div class="page factura">
				<h2>
					<span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura cancelada</span>
					<span t-if="o.move_type == 'out_invoice' and o.state == 'annul'">Factura anulada</span>
				</h2>
				<!-- Logo + Empresa + Caja RUC (movido desde el header de wkhtmltopdf
				     al body, para funcionar con o sin logo de company) -->
				<table style="width: 100%; border: 0px; margin-bottom: 8px;">
					<tr>
						<td style="width: 25%; border: 0px; text-align: center; vertical-align: middle; padding: 4px;">
							<img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
							     style="max-height: 90px; max-width: 150px;" alt="Logo" />
						</td>
						<td style="width: 42%; border: 0px; text-align: center; vertical-align: middle; padding: 8px; text-transform: uppercase;">
							<strong><t t-esc="company.name"/></strong>
							<br/>
							<t t-esc="company.street"/>
							<br/>
							<br/>
							<t t-esc="company.partner_id.l10n_pe_district.name"/>,
							<t t-esc="company.state_id.name"/>,
							<t t-esc="company.city"/>
						</td>
						<td style="width: 33%; border: 0px; vertical-align: middle; padding: 4px;">
							<div style="font-size: 21px; height: 130px; border: 1px solid #000 !important; border-radius: 5px; text-align: center;">
								<div style="padding-top: 22px;">
									<strong>RUC: <t t-esc="company.vat"/></strong>
									<br/>
									<strong>
										<t t-esc="o.pe_doc_name" />
										<br/>
									</strong>
									<strong>
										<t t-if="o.l10n_latam_document_number" t-esc="o.l10n_latam_document_number"/>
										<t t-else="" t-esc="o.name"/>
									</strong>
								</div>
							</div>
						</td>
					</tr>
				</table>
				<div class="row" style="font-size: 11px; width: 100%; margin: 0px; padding: 0px;">
					<div class="col-6 cuadro" style="border: 1px solid #000 !important; margin: 0px; padding: 0px; padding-top: 6px; padding-left: 6px;">
						<strong>SEÑOR(ES):</strong>
						<t t-esc="o.partner_id.display_name" style="word-wrap: break-word;"/>
						<br/>
						<strong><t t-if="o.partner_id.doc_type=='6'" class="col-3"> RUC: </t>
						<t t-else="" class="col-3"> DNI: </t></strong>
						<t t-esc="o.partner_id.doc_number"/>
						<br/>
						<strong>DIRECCIÓN:</strong>
						<t t-esc="o.partner_id.street" style="word-wrap: break-word;"/>
						<br/>
						<strong>FORMA DE PAGO:</strong>
						<t t-if="o.tipo_transaccion" t-esc="dict(o.fields_get(allfields=['tipo_transaccion'])['tipo_transaccion']['selection'])[o.tipo_transaccion]"/> 
						<t t-else="">
							CONTADO
						</t>
						<br/>
						<strong>PEDIDO DE VENTA:</strong>
						<t t-esc="o.obtener_pedido_venta()"/>
						<br/>
						<strong>ORDEN DE COMPRA EXTERNA:</strong>
						<t t-esc="o.ref"/>
						<br/>
						<strong>VENDEDOR:</strong>
						<t t-esc="o.invoice_user_id.name"/>
						<br/>
					</div>
					<div class="col-6" style="border: 1px solid #000 !important; padding-top: 6px; padding-left: 6px;">
						<div id="div_fecha_emision" style="width: 49%;" >
							<strong>FECHA DE EMISIÓN:</strong>
							<t t-esc="o.invoice_date"/>
						</div>
						<div class="linea-h1"/>

						<div id="div_fecha_vencimiento" style="width: 49%;">
							<strong>FECHA DE VENC. :</strong>
							<t t-esc="o.invoice_date_due"/>
						</div>
						<div id="div_fecha_vencimiento" style="width: 49%;">
							<strong>CONDICIÓN :</strong>
						</div>
					</div>
				</div>
				<t t-set="tax_totals" t-value="o.tax_totals_pe"/>
				<div class="table">
					<table class="tabla-n3" style="border: 1px solid #000 !important; border-radius: 1px; width: 100%;">
						<tr style="font-size: 13px;">
							<th style="border: 1px solid #000 !important; width: 10%; padding: 1px;">
								<strong>ITEM</strong>
							</th>
							<th style="border: 1px solid #000 !important; width: 15%;">
								<strong>CÓDIGO</strong>
							</th>
							<th style="border: 1px solid #000 !important; width: 25%;">
								<strong>DESCRIPCIÓN</strong>
							</th>
							<th style="border: 1px solid #000 !important;border-left: 3px solid #000 !important;">
								<strong>CANTIDAD</strong>
							</th>
							<th style="border: 1px solid #000 !important;">
								<strong>UNIDAD</strong>
							</th>
							<th style="border: 1px solid #000 !important;">
								<strong>PRECIO UNI</strong>
							</th>
							<th style="border: 1px solid #000 !important;">
								<strong>IMPORTE</strong>
							</th>
						</tr>

						<t t-set="current_subtotal" t-value="0"/>
						<t t-set="contador" t-value="0"/>
						<t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

						<t t-foreach="lines" t-as="line">
							<t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
							<t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

							<t t-if="line.display_type in ['product']">
								<t t-set="contador" t-value="contador + 1"/>
								<tr  style="border: 0px; font-size: 11px;" class="text-center">
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;">
										<span t-esc="contador"/>
									</td>
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.product_id.product_tmpl_id.default_code"/>
									</td>
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle; text-align: left;">
										<span t-field="line.name" t-options="{'widget': 'text'}"/> 
									</td>
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.quantity"/>
									</td>
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.product_uom_id"/>
									</td>
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;">
										<span class="text-nowrap" t-field="line.price_unit"/>
									</td>
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;">
										<span t-field="line.price_total"/>
									</td>
								</tr>
							</t>

							<tr t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')" class="row">
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td>  </td>
								<td> 
									<strong class="mr16">Subtotal</strong>
									<span
										t-esc="current_subtotal"
										t-options='{"widget": "monetary", "display_currency": o.currency_id}'
									/>
								</td>
							</tr>
						</t>
						<tr style="border: 0px; font-size: 12px;text-align: left; padding: 3px;">
							<td colspan="7" style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> <strong>OC.:</strong> </td>
						</tr>
						<tr style="border: 0px; font-size: 12px;text-align: left; padding: 3px;">
							<td colspan="7" style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>OBSERVACIONES:</strong><span t-field="o.narration" /> 
							</td>
						</tr>
						<tr style="border: 0px; font-size: 12px;text-align: left; padding: 3px;">
							<td colspan="7" style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>SON:</strong> <span t-field="o.amount_text" />
							</td>
						</tr>
						<tr style="border: 0px; font-size: 12px;text-align: left; padding: 3px;">
							<td colspan="7" style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>Resumen:</strong> <span t-field="o.pe_cpe_id.digest" style="font-size: 10px;"/>
							</td>
						</tr>
						<tr style="border: 0px; font-size: 12px;text-align: left; padding: 3px;" class="text-center">
							<td colspan="3" style="border: 0px solid #fff !important; padding: 3px;vertical-align: middle;"> 
								
							</td>
							<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>TOTAL</strong>
							</td>
							<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>SUBTOTAL</strong>
							</td>
							<!-- Odoo 19: estructura tax_totals nueva con 'subtotals' > 'tax_groups' -->
							<t t-foreach="tax_totals['subtotals']" t-as="subtotal">
								<t t-foreach="subtotal['tax_groups']" t-as="tax_group">
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
										<strong>
											<t t-out="tax_group['group_name']"/>
										</strong>
									</td>
								</t>
							</t>

							
							<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>MONTO A PAGAR</strong>
							</td>
						</tr>
						<tr style="border: 0px; font-size: 12px;text-align: left; padding: 3px;" class="text-center">
							<td colspan="3" style="border: 0px solid #fff !important; padding: 3px;vertical-align: middle;"> 
								
							</td>
							<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>
									<t t-if="o.currency_id.name == 'USD'">
										<span t-field="o.total_operaciones_gravadas_dolar"/> 
									</t>
									<t t-else="">
										<span t-field="o.total_operaciones_gravadas"/> 
									</t>
								</strong>
							</td>
							<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong>
									<t t-if="o.currency_id.name == 'USD'">
										<span t-field="o.total_operaciones_gravadas_dolar"/> 
									</t>
									<t t-else="">
										<span t-field="o.total_operaciones_gravadas"/> 
									</t>
								</strong>
							</td>
							<!-- Odoo 19: montos de impuestos con widget monetary -->
							<t t-foreach="tax_totals['subtotals']" t-as="subtotal">
								<t t-foreach="subtotal['tax_groups']" t-as="tax_group">
									<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
										<strong>
											<span t-out="tax_group['tax_amount_currency']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
										</strong>
									</td>
								</t>
							</t>

							
							<td style="border: 1px solid #000 !important; padding: 3px;vertical-align: middle;"> 
								<strong><span t-out="tax_totals['total_amount_currency']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/> </strong>
							</td>
						</tr>
					</table>
				</div>

				<div >
					<div class="row texto-12" t-if="o.tiene_detraccion and company.cuenta_detraccion and company.cuenta_detraccion.bank_account_id and o.move_type == 'out_invoice'">
						<div class="col-3 text-left"> 
							<span style="font-weight: bold;" t-esc="company.cuenta_detraccion.name"/>
						</div>
						<div class="text-right o_price_total"> 
							<span class="text-nowrap"> <t t-esc="company.cuenta_detraccion.bank_account_id.acc_number"/> </span> 
						</div>
					</div>

					<div class="row texto-12" t-if="o.tiene_detraccion and company.cuenta_detraccion and company.cuenta_detraccion.bank_account_id">
						<div style="font-weight: bold;" class="col-3 text-left"> Detracción ( <t t-esc="o.porc_detraccion"/> %)</div>
						<div class="text-right"> 
							S/ <span class="text-nowrap" t-esc="'%.2f'%(o.monto_detraccion)"/> 
						</div>
					</div>

					<div t-if="o.tiene_retencion" class="row">
						<div class="col-6 text-left"> Retención ( <t t-esc="o.porc_retencion"/> %)</div>
						<div class="col-6 text-right border-n1"> 
							<t t-esc="o.currency_id.symbol"/> <span class="text-nowrap" t-esc="'%.2f'%(o.monto_retencion)"/>
						</div>
					</div>
					
					<div t-if="o.tiene_detraccion or o.tiene_retencion"  class="row">
						<div class="col-6 text-left"> Neto a Pagar </div>
						<div class="col-6 text-right border-n1"> 
							<t t-esc="o.currency_id.symbol"/>
							<t t-if="o.currency_id.id == o.company_id.currency_id.id">
								<span class="text-nowrap" t-esc="'%.2f'%(o.monto_neto_pagar)"/> 
							</t>
							<t t-else="">
								<span class="text-nowrap" t-esc="'%.2f'%(o.monto_neto_pagar_base)"/> 
							</t>
						</div>
					</div>

				</div>
				
				
				<div  t-if="o.tiene_detraccion" style="border: 1px solid #ddd !important; border-radius: 6px; width: 100%;" class="defaulttable numeros-texto">
					OPERACIÓN SUJETA AL SISTEMA DE PAGO DE OBLIGACIONES TRIBUTARIAS
				</div>
				
				<div t-if="o.tipo_transaccion == 'credito' ">
					<br/>
					 <table style="border: 1px solid #ddd !important; border-radius: 6px; width: 75%;margin: 0 auto;"  >
						<thead>
							<tr> 
								<td class="cpe-gris">Nº DE CUOTA</td>
								<td class="cpe-gris">IMPORTE</td>
								<td class="cpe-gris">FECHA DE PAGO</td>
							</tr>
						</thead>
						<tbody style="border: 0px;margin: 0px; padding: 0px;">
							<t t-set="contador" t-value="0"/>
							<t t-foreach="o.obtener_cuotas_pago()" t-as="cuota">
								<t t-set="contador" t-value="contador + 1"/>
								<tr style="margin: 0px; padding: 0px;">
									<td class="td-n1" style="border: 0px;margin: 0px; padding: 0px;">Cuota<t t-esc="'{0:03d}'.format(contador)"/></td>
									<td class="td-n1" style="border: 0px;margin: 0px; padding: 0px;"><span t-esc="'%.2f'%(cuota['amount'])"/></td>
									<td class="td-n1" style="border: 0px;margin: 0px; padding: 0px;"><span t-esc="cuota['date_maturity']"/></td>
								</tr>
							</t>
							
						</tbody>
					 </table>
				</div>

				<!--<p t-if="o.invoice_payment_term_id" name="payment_term">
					<span t-field="o.invoice_payment_term_id.note"/>
				</p>-->
				<p t-if="o.fiscal_position_id.note" name="note">
					<span t-field="o.fiscal_position_id.note"/>
				</p>
				<div id="qrcode" t-if="(o.company_id.qr_code) and (o.currency_id.name == 'EUR') and (o.invoice_partner_bank_id.acc_number != False)">
					<p t-if="(o.invoice_partner_bank_id.qr_code_valid)">
						<strong class="text-center">Scan me with your banking app.</strong><br /><br />
						<img class="border border-dark rounded" t-att-src="o.invoice_partner_bank_id.build_qr_code_url(o.amount_residual, o.invoice_payment_ref or o.ref or o.name)"/>
					</p>
					<p t-if="(o.invoice_partner_bank_id.qr_code_valid == False)">
						<strong class="text-center">The SEPA QR Code informations are not set correctly.</strong><br />
					</p>
				</div>
			</div>
			<div class="col-xs-12" t-if="o.is_cpe" style="padding: 2mm">
				<img t-if="o.sunat_qr_code" t-att-src="image_data_uri(o.sunat_qr_code)"
				     style="width: 150px; height: 150px;" alt="QR"/>
			</div>

		</div>
		
		<div class="footer" >
			<br/>
			<div class="text-center" style="border-top: 1px solid black;">
				<ul class="list-inline mb4">
					<li t-if="company.phone">Telefono: 
						<span t-field="company.phone"/></li>
					<li t-if="company.email">Email: 
						<span t-field="company.email"/></li>
					<li t-if="company.website">Web: <span t-field="company.website"/></li>

					<!--<li t-if="company.website">
						Representación impresa de factura electrónica, consulta en <span t-field="company.website"/></li>-->
				</ul>
				<!--<div name="financial_infos">
					<span t-field="company.report_footer"/>
				</div>-->
				<div class="text-muted">
					<span class="page"/>
					de  
					<span class="topage"/></div>
			</div>
			
			<br/>
		</div>
	</template>
	<template id="solse_pe_cpe_pdf_ee.cpe_print" name="solse_pe_cpe_pdf_ee.cpe_print">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
				<t t-call="solse_pe_cpe_pdf_ee.cpe_body_print" t-lang="lang"/>
			</t>
		</t>
	</template>
