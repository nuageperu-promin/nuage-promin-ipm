	<template id="solse_pe_cpe_pdf_ee.report_invoice_with_payments">
		<t t-call="web.html_container">
			<t t-foreach="docs" t-as="o">
				<t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
				<t t-call="solse_pe_cpe_pdf_ee.cpe_body_print" t-lang="lang"/>
			</t>
		</t>
	</template>

	<record id="report_cpe_sunat_plantilla_2" model="ir.actions.report">
		<field name="name">Factura (Formato 2)</field>
		<field name="model">account.move</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">solse_pe_cpe_pdf_ee.report_invoice_with_payments</field>
		<field name="report_file">solse_pe_cpe_pdf_ee.report_invoice_with_payments</field>
		<field name="binding_model_id" ref="account.model_account_move"/>
		<field name="binding_type">report</field>
	</record>

	<record id="solse_pe_cpe_pdf_ee.paperformat_factura_n1" model="report.paperformat">
		<field name="name">Factura (Plantilla 2)</field>
		<field name="default" eval="True" />
		<field name="format">custom</field>
		<field name="page_height">297</field>
		<field name="page_width">210</field>
		<field name="orientation">Portrait</field>
		<!-- Header de wkhtmltopdf vacío -> margen estándar y sin spacing reservado. -->
		<field name="margin_top">10</field>
		<field name="header_spacing">0</field>
		<field name="margin_bottom">30</field>
		<field name="margin_left">7</field>
		<field name="margin_right">7</field>
		<field name="header_line" eval="False" /><!-- mostrar una linea en cabecera-->
		<field name="dpi">90</field>
