<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sire_crear_factura_wizard_form" model="ir.ui.view">
            <field name="name">solse.pe.sire.crear.factura.wizard.form</field>
            <field name="model">solse.pe.sire.crear.factura.wizard</field>
            <field name="arch" type="xml">
                <form string="Crear factura">
                    <field name="company_id" invisible="1"/>
                    <field name="compra_id" invisible="1"/>
                    <field name="analytic_precision" invisible="1"/>
                    <group>
                        <field name="etiqueta"/>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="analytic_distribution" widget="analytic_distribution"
                               groups="analytic.group_analytic_accounting"
                               options="{'account_field': 'account_id', 'business_domain': 'invoice'}"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                    </group>
                    <footer>
                        <button name="action_crear_factura" string="Grabar" type="object"
                                class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sire_crear_factura_wizard" model="ir.actions.act_window">
            <field name="name">Crear factura</field>
            <field name="res_model">solse.pe.sire.crear.factura.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
