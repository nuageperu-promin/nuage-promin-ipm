<odoo>
	<data>
		<record model="ir.ui.view" id="view_warehouse">
			<field name="name">stock.warehouse.form.inherit.solse.cpe.sunat.eguide</field>
			<field name="model">stock.warehouse</field>
			<field name="inherit_id" ref="stock.view_warehouse" />
			<field name="arch" type="xml">

				<xpath expr="//field[@name='partner_id']" position="after">
					<field name="eguide_sequence_id" groups="solse_pe_cpe.group_solse_pe_cpe_manager" />
					<field name="mostrar_loteserie_porlineas" />
				</xpath>

			</field>
		</record>

		<record model="ir.ui.view" id="view_company_form">
			<field name="name">stock.picking.form.inherit.solse.cpe.sunat.eguide</field>
			<field name="model">stock.picking</field>
			<field name="inherit_id" ref="stock.view_picking_form" />
			<field name="arch" type="xml">
				<xpath expr="//button[@name='action_assign']" position="after">
					<button name="action_generate_eguide" string="Generar Guía Electronica" type="object" 
						invisible="pe_is_eguide == False or pe_guide_state in ['send','verify','done']" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
					<button name="action_cancel_eguide" string="Cancelar Guía Electronica" type="object" invisible="1" />
				</xpath>
				<xpath expr="//field[@name='user_id']" position="after">
					<field name="forzar_reserva" />
				</xpath>
				<xpath expr="//page[@name='extra']" position="after">
					<page string="Personalización Peruana" name="peruvian_customization" invisible="state not in ['done']">
						<group>
							<group>
								<field name="pe_is_eguide" readonly="pe_guide_number != '/'"/>
								<field name="pe_guide_id" groups="solse_pe_cpe.group_solse_pe_cpe_user" invisible="pe_is_eguide != '/'" readonly="1" />
								<field name="pe_response" invisible="pe_is_eguide == False" readonly="1" />
								<field name="pe_note" invisible="pe_is_eguide == False" readonly="1" />
							</group>
							<group>
								<field name="pe_guide_number" invisible="pe_is_eguide == False" readonly="1" />
								<field name="pe_voided_id" groups="solse_pe_cpe.group_solse_pe_cpe_user" invisible="1" />
								<field name="pe_error_code" invisible="pe_is_eguide == False" readonly="1" />
								<field name="pe_guide_state" invisible="1" />
								<field name="ocultar_en_pdf" invisible="pe_is_eguide == False" />
							</group>
						</group>
						<group string="Información de la guía electrónica" groups="solse_pe_cpe.group_solse_pe_cpe_user">
							<group>
								<field name="pe_transfer_code" required="pe_is_eguide == True" readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="motivo_transferencia" required="pe_transfer_code == '13'" invisible="pe_transfer_code != '13'" groups="" />
								<field name="pe_gross_weight" required="pe_is_eguide == True" readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="pe_unit_quantity" required="pe_transfer_code == '08' and not pe_contenedor_ids" readonly="pe_guide_number != '/' or pe_contenedor_ids" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="supplier_id" domain="[('supplier_rank','=',1), ('parent_id', '=', False)]" readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
							</group>
							<group>
								<field name="pe_is_realeted" invisible="1"/>
								<field name="pe_related_number" invisible="1"/>
								<field name="pe_related_code" invisible="1"/>
								<field name="pe_is_programmed" string="Consignación dividida" readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="pe_transport_mode" required="pe_is_eguide == True" readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="pe_carrier_id" invisible="pe_transport_mode not in ['01']" required="pe_transport_mode == '01'"  readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
								<field name="pe_delivery_date" invisible="pe_transport_mode != '01'" required="pe_transport_mode == '01'" readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user" />
							</group>
						</group>
						<group string="Documentos relacionados" groups="solse_pe_cpe.group_solse_pe_cpe_user" col="1">
							<field name="pe_documento_relacionado_ids" nolabel="1" readonly="pe_guide_number != '/'">
								<list editable="bottom">
									<field name="sequence" widget="handle"/>
									<field name="codigo_documento" required="1"/>
									<field name="numero_documento" required="1"/>
									<field name="emisor_requerido" column_invisible="1"/>
									<field name="emisor_id" required="emisor_requerido" options="{'no_create': True}"/>
								</list>
							</field>
						</group>
						<group string="Indicadores SUNAT" groups="solse_pe_cpe.group_solse_pe_cpe_user">
							<group>
								<field name="pe_es_subregimen_19_92" invisible="1"/>
								<field name="pe_puerto_id"
										   invisible="pe_transfer_code not in ('08', '09')"
										   readonly="pe_guide_number != '/'"
										   options="{'no_create_edit': True}"/>
								<field name="pe_traslado_total_dam" readonly="pe_guide_number != '/'"
									   invisible="pe_transfer_code not in ('08', '09', '19')"/>
								<field name="pe_traslado_contenedor_mc" readonly="pe_guide_number != '/'"
									   invisible="pe_transfer_code not in ('08', '09')"/>
								<field name="pe_vehiculos_m1_l" readonly="pe_guide_number != '/'"/>
							</group>
							<group>
								<field name="pe_transbordo_programado" readonly="pe_guide_number != '/'"
									   invisible="pe_transport_mode != '01'"/>
								<field name="pe_registro_vehiculos_conductores" readonly="pe_guide_number != '/'"
									   invisible="pe_transport_mode != '01'"/>
								<field name="pe_retorno_vehiculo_vacio" readonly="pe_guide_number != '/'"/>
								<field name="pe_retorno_envase_vacio" readonly="pe_guide_number != '/'"/>
							</group>
						</group>
						<group string="Contenedores" groups="solse_pe_cpe.group_solse_pe_cpe_user"
							   invisible="pe_es_subregimen_19_92" col="1">
							<field name="pe_contenedor_ids" nolabel="1" readonly="pe_guide_number != '/'">
								<list editable="bottom">
									<field name="sequence" widget="handle"/>
									<field name="numero_contenedor" required="1"/>
									<field name="numero_precinto"/>
								</list>
							</field>
						</group>
						<!-- Se cambio la vista tree por list en v18-->
						<!-- Vehículos y conductores.
							 Modalidad 02-Privado: siempre.
							 Modalidad 01-Público: solo con el 'Indicador de registro
							 de vehículos y conductores del transportista'
							 (RS 255-2015 art. 3, num. 3.1 último párrafo).
							 Nunca en traslados M1/L (ERR-3455). -->
						<field name="pe_fleet_ids" nolabel="1" widget="one2many_list" mode="list"
							   invisible="pe_vehiculos_m1_l or pe_transport_mode not in ['02'] and not (pe_transport_mode == '01' and pe_registro_vehiculos_conductores)"
							   readonly="pe_guide_number != '/'" groups="solse_pe_cpe.group_solse_pe_cpe_user">
							<list string="Vehículos y conductores" editable="bottom">
								<field name="fleet_id" string="Vehículo" />
								<field name="name" string="Placa"/>
								<field name="pe_tuce" string="TUCE / Cert. habilitación"/>
								<field name="driver_id" string="Conductor"/>
								<field name="is_main" />
							</list>
						</field>
						<div>
							<label for="pe_digest" string="Valor de codigo:" invisible="pe_is_eguide == False" readonly="1" />
							<field name="pe_digest" invisible="pe_is_eguide == False" readonly="1" />
						</div>
						<div>
							<label for="pe_signature" string="Valor de la firma:" invisible="pe_is_eguide == False" readonly="1" />
						</div>
						<div>
							<field name="pe_signature" invisible="pe_is_eguide == False" readonly="1" />
						</div>
					</page>
				</xpath>
			</field>
		</record>

	</data>
</odoo>