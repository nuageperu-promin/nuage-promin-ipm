<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!--Se cambia la vista de tree a list en v18-->
    <!-- nueva vista lista lote -->
    <record id="detalle_transferencia_tree" model="ir.ui.view">
        <field name="name">stock.move.cpe.sale.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list create="0" class="lista">
                <field name="id" invisible="1"/>
                <field name="company_id" optional="show"/>              
                <field name="date" widget="date" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="product_qty" optional="show"/>
                <field name="product_uom_qty" optional="show"/>
                <field name="product_uom" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="location_dest_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="state" optional="show"/>
                <field name="price_unit" optional="show"/>
                <field name="origin" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="reference" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_detalles_ventas_search" model="ir.ui.view">
		<field name="name">stock.move.search.cpe.sale.view</field>
		<field name="model">stock.move</field>
		<field name="arch" type="xml">
			<search string="Detalle de Trasferencia">
				<field name="product_id"/>
                <field name="partner_id"/>
                <field name="origin"/>
                <field name="warehouse_id"/>
                <field name="reference"/>

				<group>
					<filter string="Producto" name='producto' context="{'group_by':'product_id'}"/>
                    <filter string="Fecha" name='fecha_pedido' context="{'group_by':'date'}"/>
                    <filter string="Cliente" name='cliente' context="{'group_by':'partner_id'}"/>
                    <filter string="Estado" name='estado' context="{'group_by':'state'}"/>
					<separator orientation="vertical" />
				</group>
				
			</search>
		</field>
	</record>

    <!-- accion lote -->
    <record id="detalle_transferencia_action" model="ir.actions.act_window">
        <field name="name">Detalles Trasferencia</field>
        <field name="res_model">stock.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,graph</field>
        <field name="view_id" ref="detalle_transferencia_tree"/>
        <field name="search_view_id" ref="view_detalles_ventas_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record> 

    <menuitem id="menu_transferencia_detallada" name="Ordenes Trasferencia detallado" parent="stock.menu_stock_warehouse_mgmt" action="detalle_transferencia_action" sequence="20"/>

  </data>
</odoo>