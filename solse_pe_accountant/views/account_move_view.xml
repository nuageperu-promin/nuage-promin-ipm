<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_account_move_form_apertura" model="ir.ui.view">
		<field name="name">account.move.form.apertura</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="solse_pe_edi.view_move_form_or"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='monto_retencion']" position="after">
				<field name="es_x_apertura"/>
				<field name="es_x_cierre"/>
				
				<field name="fecha_tipo_cambio" invisible="1"/>
				<field name="date" invisible="1"/>
				<!-- Fix Bug C: eliminado el campo duplicado que existía antes de es_x_apertura -->
				<field name="fecha_vencimiento_detraccion"
				       invisible="not tiene_detraccion"
				       readonly="1"
				       string="Vence detracción"/>
			</xpath>

			<!-- Detracción en cabecera para facturas de proveedor (v19.0.0.10).
			     Va antes de tiene_detraccion, que es el flag compute que ya
			     muestra solse_pe_edi. Solo visible en compras. -->
			<xpath expr="//field[@name='tiene_detraccion']" position="before">
				<field name="aplica_detraccion"
				       invisible="move_type not in ('in_invoice', 'in_refund')"
				       readonly="state != 'draft'"
				       options="{'no_create': True, 'no_open': True}"/>
			</xpath>
		</field>
	</record>

	<!-- Agrega campo glosa al listado de apuntes contables -->
	<record id="view_move_form_bcrnt" model="ir.ui.view">
		<field name="name">account.move.form.bcrnt</field>
		<field name="model">account.move.line</field>
		<field name="inherit_id" ref="account.view_move_line_tree"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='date']" position="after">
				<field name="glosa" optional="hide"/>           
			</xpath>
		</field>
	</record>

	<record id="view_move_form_accountant" model="ir.ui.view">
	    <field name="name">account.move.form.accountant</field>
	    <field name="model">account.move</field>
	    <field name="inherit_id" ref="account.view_move_form"/>
	    <field name="arch" type="xml">

	    	<!-- Glosa despues de invoice_vendor_bill_id -->
	        <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
	            <field name="glosa" optional="hide" />
	        </xpath>

	        <!-- asiento_det_ret despues de checked (to_check fue renombrado a checked en v19) -->
	        <xpath expr="//field[@name='checked']" position="after">
	            <field name="asiento_det_ret" readonly="1" />
	        </xpath>

	        <!-- transaction_number dentro del grupo derecho del header -->
	        <xpath expr="//group[@id='header_right_group']" position="inside">
	            <field name="transaction_number" invisible="move_type not in ['entry']"/>
	        </xpath>

	        <!-- transaction_number despues de payment_reference -->
	        <xpath expr="//field[@name='payment_reference']" position="after">
	            <field name="transaction_number" invisible="move_type not in ['entry']"/>
	        </xpath>

	        <!-- Primer campo ref: cabecera factura proveedor -->
	        <xpath expr="//field[@name='ref'][1]" position="attributes">
	            <attribute name="invisible">move_type not in ['in_invoice', 'in_receipt', 'in_refund']</attribute>
	            <attribute name="required">move_type == 'in_invoice'</attribute>
	        </xpath>

	        <!-- Segundo campo ref: asiento de diario -->
	        <xpath expr="//field[@name='ref'][2]" position="attributes">
	            <attribute name="invisible">move_type in ['in_invoice', 'in_receipt', 'in_refund', 'out_invoice', 'out_refund'] and es_x_apertura == False</attribute>
	            <attribute name="required">move_type == 'in_invoice'</attribute>
	        </xpath>

	        <!-- Fix Bug D: fecha_apertura antes del div de vencimiento.
	             - required cubre cualquier move_type (antes solo out_invoice).
	             - readonly controlado por state, no hardcodeado en el campo Python. -->
	        <xpath expr="//div[@name='due_date']" position="before">
	            <field name="fecha_apertura"
	                   required="es_x_apertura == True"
	                   readonly="state != 'draft'"
	                   invisible="es_x_apertura == False" />
	        </xpath>
	    </field>
	</record>

	<!-- Agrega transaction_number en el formulario de account.payment -->
	<record id="view_account_payment_form" model="ir.ui.view">
		<field name="name">account.payment.inherit.view.form</field>
		<field name="model">account.payment</field>
		<field name="inherit_id" ref="account.view_account_payment_form"/>
		<field name="arch" type="xml">
			<!-- En Odoo 19 el campo ref fue reemplazado por memo en account.payment -->
			<xpath expr="//field[@name='memo']" position="after">
				<field name="available_partner_bank_ids" invisible="1" />
				<field name="partner_bank_id" invisible="1"/>
				<field name="transaction_number"/>
			</xpath>
		</field>
	</record>

</odoo>
