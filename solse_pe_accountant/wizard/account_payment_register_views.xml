<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml"> 
            <xpath expr="//field[@name='communication']" position="after">
                <field name="source_amount_currency"/>
                <field name="available_partner_bank_ids" widget="many2many_tags"/>
                <field name="mostrar_check" invisible="1"/>
                <field name="es_detraccion_retencion" invisible="mostrar_check == False or autodetraccion == True"/>
                <field name="tipo" invisible="mostrar_check == False" readonly="autodetraccion == True" force_save="1" />
                <field name="autodetraccion" invisible="tipo != 'normal' or mostrar_check == False or amount == 0"/>
            </xpath>

            <xpath expr="//label[@for='amount']" position="attributes">
                <attribute name="invisible">autodetraccion == True</attribute>
            </xpath>

            <xpath expr="//label[@for='amount']" position="after">
                <label for="monto_autodetraccion" invisible="autodetraccion == False"/>
            </xpath>
            <xpath expr="//div[@name='amount_div']" position="attributes">
                <attribute name="invisible">autodetraccion == True</attribute>
            </xpath>

            <xpath expr="//div[@name='amount_div']" position="after">
                <div name="amount_div" class="o_row" invisible="autodetraccion == False">
                    <field name="monto_autodetraccion"/>
                    <field name="currency_id"
                           required="1"
                           options="{'no_create': True, 'no_open': True}"
                           groups="base.group_multi_currency"/>
                </div>
            </xpath>

        </field>
    </record>


    <record id="view_account_payment_register_form_accountant" model="ir.ui.view">
        <field name="name">account.payment.register.form.solse</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="solse_pe_cpe.view_account_payment_register_form_cpe"/>
        <field name="arch" type="xml"> 
            <xpath expr="//field[@name='transaction_number']" position="attributes">
                <attribute name="required">es_detraccion_retencion == True</attribute>
            </xpath>
        </field>
    </record>


</odoo>