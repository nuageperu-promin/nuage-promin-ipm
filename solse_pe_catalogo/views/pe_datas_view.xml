<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de lista (antes tree) -->
        <record model="ir.ui.view" id="view_pe_datas_tree">
            <field name="name">pe.datas.list</field>
            <field name="model">pe.datas</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="table_code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Vista de búsqueda CORREGIDA -->
        <record id="pe_datas_search_view" model="ir.ui.view">
            <field name="name">pe.datas.search</field>
            <field name="model">pe.datas</field>
            <field name="arch" type="xml">
                <search string="Catálogos SUNAT">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="table_code"/>
                    
                    <!-- Filtros -->
                    <filter string="Activos" name="filter_active" domain="[('active', '=', True)]"/>
                    <filter string="Inactivos" name="filter_inactive" domain="[('active', '=', False)]"/>
                    
                    <separator/>
                    
                    <!-- Group By -->
                    <filter string="Código Tabla" name="group_table_code" context="{'group_by': 'table_code'}"/>
                </search>
            </field>
        </record>

        <!-- Vista de formulario -->
        <record id="view_pe_datas_from" model="ir.ui.view">
            <field name="name">pe.datas.form</field>
            <field name="model">pe.datas</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="un_ece_code"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="table_code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description"/>
                </form>
            </field>
        </record>
        
        <!-- Acción -->
        <record id="action_pe_datas" model="ir.actions.act_window">
            <field name="name">Catálogos SUNAT</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pe.datas</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="pe_datas_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo catálogo SUNAT
                </p>
            </field>
        </record>
        
        <!-- Menús -->
        <menuitem name="SUNAT" 
                  id="solse_cpe_menu_root" 
                  sequence="4" 
                  web_icon="solse_pe_catalogo,static/description/icon.png"/>
        
        <menuitem name="Configuración" 
                  id="pe_cpe_configuration_menu" 
                  parent="solse_cpe_menu_root" 
                  sequence="100"/>
        
        <menuitem name="Catálogo SUNAT" 
                  id="pe_cpe_datas_menu" 
                  parent="pe_cpe_configuration_menu" 
                  action="action_pe_datas" 
                  sequence="2"/>
    </data>
</odoo>