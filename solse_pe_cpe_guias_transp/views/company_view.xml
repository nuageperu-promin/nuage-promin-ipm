<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<data>
		<record model="ir.ui.view" id="view_company_form_eguide_transport">
			<field name="name">res.company.form.inherit.cpe.eguide.transport</field>
			<field name="model">res.company</field>
			<field name="inherit_id" ref="solse_pe_cpe_guias.view_company_form_eguide"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='pe_cpe_eguide_server_id']" position="after">
					<field name="pe_cpe_eguide_transport_server_id"
						   options="{'no_create': True}"
						   groups="solse_pe_cpe.group_solse_pe_cpe_manager"
						   domain="[('company_id', '=', id)]"/>
					<field name="pe_guide_mode"
						   groups="solse_pe_cpe.group_solse_pe_cpe_manager"/>
				</xpath>
			</field>
		</record>
	</data>
</odoo>
