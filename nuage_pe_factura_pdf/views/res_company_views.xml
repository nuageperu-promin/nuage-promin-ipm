<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nuage_fac_res_company_form" model="ir.ui.view">
        <field name="name">res.company.form.nuage.fac</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Facturas PDF (PROMIN)" name="nuage_fac">
                    <group>
                        <field name="nuage_fac_mensaje_retencion"/>
                        <field name="nuage_fac_autorizacion"/>
                        <field name="nuage_fac_url_consulta"/>
                        <field name="nuage_fac_powered"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
