<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="promin_survey_desempeno" model="survey.survey">
        <field name="title">Evaluación de Desempeño 2026 - 1er semestre (PROMIN)</field>
        <field name="promin_tipo">desempeno</field>
        <field name="survey_type">survey</field>
        <field name="access_mode">token</field>
        <field name="users_login_required" eval="False"/>
        <field name="questions_layout">page_per_section</field>
        <field name="scoring_type">no_scoring</field>
        <field name="users_can_go_back" eval="True"/>
        <field name="description" type="html"><![CDATA[<p>La presente evaluación busca <b>medir de manera objetiva las competencias blandas del colaborador</b>. Para una adecuada calificación, los jefes deben recordar situaciones en donde se pongan de manifiesto las conductas descritas en la presente encuesta.</p><p><b>NOTA:</b> Por ningún motivo se debe calificar en función a la personalidad del colaborador, sino en función a la conducta mostrada.</p>]]></field>
        <field name="description_done" type="html"><![CDATA[<p>Gracias por completar la evaluación.</p>]]></field>
    </record>

    <record id="promin_survey_desempeno_sec1" model="survey.question">
        <field name="survey_id" ref="promin_survey_desempeno"/>
        <field name="title">1. Datos de la evaluación</field>
        <field name="is_page" eval="True"/>
        <field name="sequence">1</field>
        <field name="description" type="html"><![CDATA[<p>Estos datos se completan automáticamente al generar la evaluación.</p>]]></field>
    </record>

    <record id="promin_survey_desempeno_q2" model="survey.question">
        <field name="survey_id" ref="promin_survey_desempeno"/>
        <field name="title">Área</field>
        <field name="question_type">char_box</field>
        <field name="sequence">2</field>
        <field name="constr_mandatory" eval="False"/>
        <field name="promin_precarga">area</field>
    </record>

    <record id="promin_survey_desempeno_q3" model="survey.question">
        <field name="survey_id" ref="promin_survey_desempeno"/>
