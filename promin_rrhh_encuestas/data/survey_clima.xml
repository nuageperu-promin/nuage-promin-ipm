<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="promin_survey_clima" model="survey.survey">
        <field name="title">Encuesta de Clima Laboral - Proveedores Mineros</field>
        <field name="promin_tipo">clima</field>
        <field name="survey_type">survey</field>
        <field name="access_mode">public</field>
        <field name="users_login_required" eval="False"/>
        <field name="questions_layout">page_per_section</field>
        <field name="scoring_type">no_scoring</field>
        <field name="users_can_go_back" eval="True"/>
        <field name="description" type="html"><![CDATA[<p>Esta encuesta es <b>confidencial</b>. Si nos brinda la <b>información real</b> nos permitirá mejorar. Por favor, lea atentamente y responda con mucha honestidad.</p>]]></field>
        <field name="description_done" type="html"><![CDATA[<p>Le agradecemos por el tiempo brindado en el llenado de la encuesta.</p>]]></field>
    </record>

    <record id="promin_survey_clima_sec1" model="survey.question">
        <field name="survey_id" ref="promin_survey_clima"/>
        <field name="title">1. Información general</field>
        <field name="is_page" eval="True"/>
        <field name="sequence">1</field>
        <field name="description" type="html"><![CDATA[<p>Esta encuesta es <b>CONFIDENCIAL</b>, y si nos brinda la <b>INFORMACIÓN REAL</b> nos permitirá mejorar. Por favor, <b>LEA ATENTAMENTE</b> y responda con mucha honestidad.</p>]]></field>
    </record>

