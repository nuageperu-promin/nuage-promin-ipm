                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '58%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="nuage_patrimonio_usd_mov_res_acum" model="account.report.expression">
                        <field name="label">res_acum</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '59%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="nuage_patrimonio_usd_mov_total" model="account.report.expression">
                        <field name="label">total</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_MOV.capital + NPUSD_MOV.acc_inv + NPUSD_MOV.cap_adic + NPUSD_MOV.res_no_real + NPUSD_MOV.exc_reval + NPUSD_MOV.reservas + NPUSD_MOV.res_acum</field>
                    </record>
                </field>
            </record>
            <record id="nuage_patrimonio_usd_l_fin" model="account.report.line">
                <field name="name">Saldos al final del período</field>
                <field name="code">NPUSD_FIN</field>
                <field name="sequence">4</field>
                <field name="expression_ids">
                    <record id="nuage_patrimonio_usd_fin_capital" model="account.report.expression">
                        <field name="label">capital</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.capital + NPUSD_MOV.capital</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_acc_inv" model="account.report.expression">
                        <field name="label">acc_inv</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.acc_inv + NPUSD_MOV.acc_inv</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_cap_adic" model="account.report.expression">
                        <field name="label">cap_adic</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.cap_adic + NPUSD_MOV.cap_adic</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_res_no_real" model="account.report.expression">
                        <field name="label">res_no_real</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.res_no_real + NPUSD_MOV.res_no_real</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_exc_reval" model="account.report.expression">
                        <field name="label">exc_reval</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.exc_reval + NPUSD_MOV.exc_reval</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_reservas" model="account.report.expression">
                        <field name="label">reservas</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.reservas + NPUSD_MOV.reservas</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_res_acum" model="account.report.expression">
                        <field name="label">res_acum</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_INI.res_acum + NPUSD_MOV.res_acum + NPUSD_RES.res_acum</field>
                    </record>
                    <record id="nuage_patrimonio_usd_fin_total" model="account.report.expression">
                        <field name="label">total</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPUSD_FIN.capital + NPUSD_FIN.acc_inv + NPUSD_FIN.cap_adic + NPUSD_FIN.res_no_real + NPUSD_FIN.exc_reval + NPUSD_FIN.reservas + NPUSD_FIN.res_acum</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <record id="nuage_patrimonio_action" model="ir.actions.client">
        <field name="name">Estado de Cambios en el Patrimonio</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('nuage_patrimonio_sol')}"/>
    </record>
    <menuitem id="nuage_patrimonio_menu" name="Estado de Cambios en el Patrimonio"
              parent="account.menu_finance_reports" action="nuage_patrimonio_action" sequence="45"/>
