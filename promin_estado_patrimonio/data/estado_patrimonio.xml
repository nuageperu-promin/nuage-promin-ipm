                    </record>
                    <record id="nuage_patrimonio_sol_mov_reservas" model="account.report.expression">
                        <field name="label">reservas</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '58%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="nuage_patrimonio_sol_mov_res_acum" model="account.report.expression">
                        <field name="label">res_acum</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '59%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="nuage_patrimonio_sol_mov_total" model="account.report.expression">
                        <field name="label">total</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_MOV.capital + NPSOL_MOV.acc_inv + NPSOL_MOV.cap_adic + NPSOL_MOV.res_no_real + NPSOL_MOV.exc_reval + NPSOL_MOV.reservas + NPSOL_MOV.res_acum</field>
                    </record>
                </field>
            </record>
            <record id="nuage_patrimonio_sol_l_fin" model="account.report.line">
                <field name="name">Saldos al final del período</field>
                <field name="code">NPSOL_FIN</field>
                <field name="sequence">4</field>
                <field name="expression_ids">
                    <record id="nuage_patrimonio_sol_fin_capital" model="account.report.expression">
                        <field name="label">capital</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.capital + NPSOL_MOV.capital</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_acc_inv" model="account.report.expression">
                        <field name="label">acc_inv</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.acc_inv + NPSOL_MOV.acc_inv</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_cap_adic" model="account.report.expression">
                        <field name="label">cap_adic</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.cap_adic + NPSOL_MOV.cap_adic</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_res_no_real" model="account.report.expression">
                        <field name="label">res_no_real</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.res_no_real + NPSOL_MOV.res_no_real</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_exc_reval" model="account.report.expression">
                        <field name="label">exc_reval</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.exc_reval + NPSOL_MOV.exc_reval</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_reservas" model="account.report.expression">
                        <field name="label">reservas</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.reservas + NPSOL_MOV.reservas</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_res_acum" model="account.report.expression">
                        <field name="label">res_acum</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.res_acum + NPSOL_MOV.res_acum + NPSOL_RES.res_acum</field>
                    </record>
                    <record id="nuage_patrimonio_sol_fin_total" model="account.report.expression">
                        <field name="label">total</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_FIN.capital + NPSOL_FIN.acc_inv + NPSOL_FIN.cap_adic + NPSOL_FIN.res_no_real + NPSOL_FIN.exc_reval + NPSOL_FIN.reservas + NPSOL_FIN.res_acum</field>
