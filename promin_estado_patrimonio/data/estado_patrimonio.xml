<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nuage_patrimonio_sol" model="account.report">
        <field name="name">Estado de Cambios en el Patrimonio (SOL)</field>
        <field name="filter_analytic" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="column_ids">
            <record id="nuage_patrimonio_sol_col_capital" model="account.report.column">
                <field name="name">Capital</field>
                <field name="expression_label">capital</field>
                <field name="sequence">1</field>
            </record>
            <record id="nuage_patrimonio_sol_col_acc_inv" model="account.report.column">
                <field name="name">Acciones de inversión</field>
                <field name="expression_label">acc_inv</field>
                <field name="sequence">2</field>
            </record>
            <record id="nuage_patrimonio_sol_col_cap_adic" model="account.report.column">
                <field name="name">Capital adicional</field>
                <field name="expression_label">cap_adic</field>
                <field name="sequence">3</field>
            </record>
            <record id="nuage_patrimonio_sol_col_res_no_real" model="account.report.column">
                <field name="name">Resultados no realizados</field>
                <field name="expression_label">res_no_real</field>
                <field name="sequence">4</field>
            </record>
            <record id="nuage_patrimonio_sol_col_exc_reval" model="account.report.column">
                <field name="name">Excedente de revaluación</field>
                <field name="expression_label">exc_reval</field>
                <field name="sequence">5</field>
            </record>
            <record id="nuage_patrimonio_sol_col_reservas" model="account.report.column">
                <field name="name">Reservas</field>
                <field name="expression_label">reservas</field>
                <field name="sequence">6</field>
            </record>
            <record id="nuage_patrimonio_sol_col_res_acum" model="account.report.column">
                <field name="name">Resultados acumulados</field>
                <field name="expression_label">res_acum</field>
                <field name="sequence">7</field>
            </record>
            <record id="nuage_patrimonio_sol_col_total" model="account.report.column">
                <field name="name">Total</field>
                <field name="expression_label">total</field>
                <field name="sequence">8</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="nuage_patrimonio_sol_l_ini" model="account.report.line">
                <field name="name">Saldos al inicio del período</field>
                <field name="code">NPSOL_INI</field>
                <field name="sequence">1</field>
                <field name="expression_ids">
                    <record id="nuage_patrimonio_sol_ini_capital" model="account.report.expression">
                        <field name="label">capital</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '50%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_acc_inv" model="account.report.expression">
                        <field name="label">acc_inv</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '51%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_cap_adic" model="account.report.expression">
                        <field name="label">cap_adic</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '52%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_res_no_real" model="account.report.expression">
                        <field name="label">res_no_real</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '56%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_exc_reval" model="account.report.expression">
                        <field name="label">exc_reval</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '57%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_reservas" model="account.report.expression">
                        <field name="label">reservas</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), ('account_id.code', '=like', '58%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_res_acum" model="account.report.expression">
                        <field name="label">res_acum</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), '|', '|', ('account_id.code', '=like', '59%'), ('account_id.code', '=like', '6%'), ('account_id.code', '=like', '7%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="nuage_patrimonio_sol_ini_total" model="account.report.expression">
                        <field name="label">total</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_INI.capital + NPSOL_INI.acc_inv + NPSOL_INI.cap_adic + NPSOL_INI.res_no_real + NPSOL_INI.exc_reval + NPSOL_INI.reservas + NPSOL_INI.res_acum</field>
                    </record>
                </field>
            </record>
            <record id="nuage_patrimonio_sol_l_res" model="account.report.line">
                <field name="name">Resultado del ejercicio</field>
                <field name="code">NPSOL_RES</field>
                <field name="sequence">2</field>
                <field name="expression_ids">
                    <record id="nuage_patrimonio_sol_res_res_acum" model="account.report.expression">
                        <field name="label">res_acum</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('move_id.nuage_cierre_id', '=', False), '|', ('account_id.code', '=like', '6%'), ('account_id.code', '=like', '7%')]</field>
                        <field name="subformula">-sum</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="nuage_patrimonio_sol_res_total" model="account.report.expression">
                        <field name="label">total</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NPSOL_RES.res_acum</field>
                    </record>
                </field>
            </record>
            <record id="nuage_patrimonio_sol_l_mov" model="account.report.line">
