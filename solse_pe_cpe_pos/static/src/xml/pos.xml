<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[1]" position="inside">
            <t t-if="currentOrder.isToInvoice()">
                <h2 style="text-align: center; font-weight: bold;">Seleccionar Tipo Doc.</h2>
                <!--
                    El tipo de comprobante a mostrar se decide por la naturaleza de la orden
                    (isRefund), NO por el monto neto. Esto cubre correctamente el caso de
                    devolución compensada con recarga de billetera/gift card (monto neto = 0
                    pero sigue siendo NC) y el caso de comprobante gratuito (monto = 0 que
                    sigue siendo factura/boleta).
                -->
                <t t-foreach="pos.config.documento_venta_ids" t-as="doc_venta_id" t-key="doc_venta_id.id">
                    <t t-if="!currentOrder.isRefund">
                        <button 
                            class="button btn py-3 text-start rounded-0 border-bottom"
                            t-att-class="{
                                'btn-primary text-white': this.docState.selectedDocType === doc_venta_id.id,
                                'btn-light': this.docState.selectedDocType !== doc_venta_id.id
                            }"
                            t-on-click="() => this.click_tipo_doc(doc_venta_id.id)"
                            t-if="doc_venta_id.code != '07' ">
                            <i class="fa fa-file-text-o me-2" />
                            <t t-esc="doc_venta_id.name" />
                        </button>
                    </t>
                    <t t-else="">
                        <button 
                            class="button btn py-3 text-start rounded-0 border-bottom"
                            t-att-class="{
                                'btn-primary text-white': this.docState.selectedDocType === doc_venta_id.id,
                                'btn-light': this.docState.selectedDocType !== doc_venta_id.id
                            }"
                            t-on-click="() => this.click_tipo_doc(doc_venta_id.id)"
                            t-if="doc_venta_id.code == '07' ">
                            <i class="fa fa-file-text-o me-2" />
                            <t t-esc="doc_venta_id.name" />
                        </button>
                    </t>
                </t>
            </t>
        </xpath>
    </t>
    
    <t t-name="point_of_sale.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//td[hasclass('partner-line-email')]" position="inside">
            <div t-if="props.partner.vat" class="email-vat">
                <t t-esc="props.partner.l10n_latam_identification_type_id?.name" />: <t t-esc="props.partner.vat" />
            </div>
        </xpath>
    </t>
    
    <t t-name="point_of_sale.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//t[@t-esc='order.pos_reference']" position="replace">
            <t t-if="order.get_cpe_type()">
                <t t-esc="order.get_number()" />
            </t>
            <t t-else="">
                <t t-esc="order.pos_reference" />
            </t>
        </xpath>
    </t>
</templates>