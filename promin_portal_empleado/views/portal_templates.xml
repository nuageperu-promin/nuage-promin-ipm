<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tarjetas en la página de inicio del portal -->
    <template id="portal_my_home_empleado" inherit_id="portal.portal_my_home" name="Portal del Empleado: tarjetas">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-if="request.env['hr.employee'].sudo().search_count([('promin_portal_user_id', '=', request.env.user.id)])">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Mis datos</t>
                    <t t-set="text">DNI, derechohabientes, estudios, experiencia y CUL</t>
                    <t t-set="url" t-value="'/my/empleado/datos'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Mis documentos</t>
                    <t t-set="text">Contratos de trabajo y boletas de pago</t>
                    <t t-set="url" t-value="'/my/empleado/documentos'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Mis datos -->
    <template id="portal_datos" name="Portal del Empleado: Mis datos">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container mb-5">
                <h3 class="mt-3">Mis datos</h3>
                <p class="text-muted">
                    Lo que usted registre o cambie aquí será revisado por Recursos Humanos antes de
                    incorporarse a su legajo.
                </p>
                <div t-if="aviso == 'enviado'" class="alert alert-success" role="alert">
                    Enviado correctamente. Recursos Humanos lo revisará.
                </div>
                <t t-foreach="tipos.items()" t-as="par">
                    <t t-set="tipo" t-value="par[0]"/>
                    <t t-set="config" t-value="par[1]"/>
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong t-out="config['plural']"/>
                            <a t-attf-href="/my/empleado/datos/nuevo/#{tipo}" class="btn btn-sm btn-primary">
                                + Agregar
                            </a>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li t-if="not por_tipo[tipo]" class="list-group-item text-muted">
                                Aún no ha registrado información.
                            </li>
                            <li t-foreach="por_tipo[tipo]" t-as="d" class="list-group-item">
                                <div class="d-flex justify-content-between flex-wrap gap-2">
                                    <div>
                                        <div t-out="d.name"/>
                                        <small class="text-muted" t-if="d.parentesco" t-out="parentescos.get(d.parentesco)"/>
                                        <div t-foreach="d.attachment_ids" t-as="a">
                                            <a t-attf-href="/my/empleado/archivo/#{d.id}/#{a.id}" target="_blank">
                                                <i class="fa fa-paperclip"/> <span t-out="a.name"/>
                                            </a>
                                        </div>
                                        <div t-if="d.state == 'rechazado'" class="text-danger mt-1">
                                            Motivo del rechazo: <span t-out="d.motivo_rechazo"/>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span t-if="d.state == 'pendiente'" class="badge text-bg-warning">Pendiente de revisión</span>
                                        <span t-elif="d.state == 'aprobado'" class="badge text-bg-success">Aprobado</span>
                                        <span t-elif="d.state == 'rechazado'" class="badge text-bg-danger">Rechazado</span>
                                        <div class="mt-2 d-flex gap-2 justify-content-end">
                                            <a t-if="d.state in ('pendiente', 'rechazado')"
                                               t-attf-href="/my/empleado/datos/#{d.id}/editar" class="btn btn-sm btn-secondary">Editar</a>
                                            <a t-if="d.state == 'aprobado'"
                                               t-attf-href="/my/empleado/datos/#{d.id}/cambio" class="btn btn-sm btn-secondary">Solicitar cambio</a>
                                            <form t-if="d.state in ('pendiente', 'rechazado')" method="post"
                                                  t-attf-action="/my/empleado/datos/#{d.id}/eliminar"
                                                  onsubmit="return confirm('¿Eliminar este registro?');">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Formulario genérico -->
    <template id="portal_datos_form" name="Portal del Empleado: formulario de dato">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container mb-5" style="max-width: 720px;">
                <h3 class="mt-3">
                    <t t-if="reemplaza">Solicitar cambio: </t>
                    <t t-elif="dato">Editar: </t>
                    <t t-else="">Agregar: </t>
                    <span t-out="config['etiqueta']"/>
                </h3>
                <p class="text-muted" t-out="config['ayuda']"/>
                <div t-if="errores" class="alert alert-danger" role="alert">
                    <div t-foreach="errores" t-as="e" t-out="e"/>
                </div>
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div t-foreach="config['campos']" t-as="c" class="mb-3">
                        <label class="form-label" t-attf-for="f_#{c[0]}">
                            <span t-out="c[1]"/><span t-if="c[3]" class="text-danger"> *</span>
                        </label>
                        <t t-set="val" t-value="valores.get(c[0]) or ''"/>
                        <select t-if="c[2] == 'parentesco'" class="form-select" t-att-name="c[0]" t-attf-id="f_#{c[0]}">
                            <option value="">Seleccione…</option>
                            <option t-foreach="parentescos" t-as="p" t-att-value="p[0]" t-att-selected="p[0] == val" t-out="p[1]"/>
                        </select>
                        <input t-elif="c[2] == 'date'" type="date" class="form-control" t-att-name="c[0]"
                               t-attf-id="f_#{c[0]}" t-att-value="str(val)"/>
                        <textarea t-elif="c[2] == 'text'" class="form-control" rows="4" t-att-name="c[0]"
                                  t-attf-id="f_#{c[0]}" t-out="val"/>
                        <input t-else="" type="text" class="form-control" t-att-name="c[0]"
                               t-attf-id="f_#{c[0]}" t-att-value="val" maxlength="200"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f_adjuntos">
                            Archivos adjuntos<span t-if="config['adjunto_requerido']" class="text-danger"> *</span>
                        </label>
                        <input type="file" class="form-control" name="adjuntos" id="f_adjuntos" multiple="multiple"
                               accept=".pdf,.jpg,.jpeg,.png"/>
                        <small class="text-muted">
                            PDF, JPG o PNG. Máximo <t t-out="max_mb"/> MB por archivo y <t t-out="max_archivos"/> archivos.
                        </small>
                        <div t-if="dato and dato.attachment_ids" class="mt-2">
                            <small class="text-muted">Ya adjuntos:</small>
                            <div t-foreach="dato.attachment_ids" t-as="a">
                                <a t-attf-href="/my/empleado/archivo/#{dato.id}/#{a.id}" target="_blank" t-out="a.name"/>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Enviar a Recursos Humanos</button>
                        <a href="/my/empleado/datos" class="btn btn-light">Cancelar</a>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- Mis documentos -->
    <template id="portal_documentos" name="Portal del Empleado: Mis documentos">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container mb-5">
                <h3 class="mt-3">Mis documentos</h3>
                <div class="card mb-3">
                    <div class="card-header"><strong>Contratos y documentos</strong></div>
                    <ul class="list-group list-group-flush">
                        <li t-if="not documentos" class="list-group-item text-muted">
                            Recursos Humanos aún no ha publicado documentos para usted.
                        </li>
                        <li t-foreach="documentos" t-as="d" class="list-group-item d-flex justify-content-between">
                            <span><span t-out="d.name"/> <small class="text-muted" t-out="d.fecha"/></span>
                            <a t-attf-href="/my/empleado/documento/#{d.id}" target="_blank" class="btn btn-sm btn-primary">Ver / descargar</a>
                        </li>
                    </ul>
                </div>
                <div class="card mb-3">
                    <div class="card-header"><strong>Boletas de pago</strong></div>
                    <ul class="list-group list-group-flush">
                        <li t-if="not boletas" class="list-group-item text-muted">No tiene boletas disponibles.</li>
                        <li t-foreach="boletas" t-as="b" class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <span t-out="b.name"/>
                                <small class="text-muted">
                                    (<span t-out="b.date_from"/> al <span t-out="b.date_to"/>)
                                </small>
                                <span t-if="not b.promin_primera_lectura" class="badge text-bg-info ms-2">Nueva</span>
                            </span>
                            <a t-attf-href="/my/empleado/boleta/#{b.id}" target="_blank" class="btn btn-sm btn-primary">Ver boleta</a>
                        </li>
                    </ul>
                </div>
            </div>
        </t>
    </template>
</odoo>
