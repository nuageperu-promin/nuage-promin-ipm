<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ple.report.01 es un modelo propio (_name nuevo): la regla multiempresa
             de ple.report.templ no le aplica, hay que declararla aquí. -->
        <record id="ple_report_01_company_rule" model="ir.rule">
            <field name="name">PLE 01 por empresa</field>
            <field name="model_id" ref="model_ple_report_01"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
