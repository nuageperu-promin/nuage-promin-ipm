<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<record id="afectacion_compra_form_view" model="ir.ui.view">
			<field name="name">afectacion_compra.form</field>
			<field name="model">solse.pe.afectacion.compra</field>
			<field name="arch" type="xml">
				<form string="Afectación compra">
					<sheet>
						<div class="oe_title">
							<label for="name"/>
							<h1><field name="name" placeholder="ej: Gravada destinada a op. gravadas"/></h1>
						</div>
						<group>
							<group>
								<field name="codigo"/>
								<field name="categoria"/>
								<field name="sequence"/>
								<field name="active"/>
							</group>
							<group string="Inclusión en libros SIRE">
								<field name="aplica_rce"/>
								<field name="aplica_rce_no_dom"/>
							</group>
						</group>
						<notebook>
							<page string="Impuestos y mapeo a columnas SIRE" name="impuestos">
								<field name="impuesto_afect_ids">
									<list editable="bottom">
										<field name="impuesto_id" domain="[('type_tax_use', 'in', ['purchase'])]" required="True"/>
										<field name="toma_para_calculo"/>
										<field name="nro_col_importe_impuesto"/>
									</list>
								</field>
								<group string="Impuestos por defecto (al seleccionar esta afectación)" col="1">
									<field name="impuesto_defecto_ids" widget="many2many_tags" nolabel="1"/>
								</group>
							</page>
							<page string="Distribución sin impuesto (exoneradas/inafectas)" name="sin_impuesto">
								<group>
									<field name="nro_col_importe_afectacion"/>
									<field name="toma_para_calculo"/>
								</group>
								<div class="alert alert-info" role="alert">
									Estos campos se aplican sólo cuando la línea de factura NO tiene
									impuestos vinculados. Caso típico: compras exoneradas/inafectas
									que van directo a la columna 21 del SIRE como "Valor de adquisiciones no gravadas".
								</div>
							</page>
						</notebook>
					</sheet>
				</form>
			</field>
		</record>

		<record id="afectacion_compra_tree_view" model="ir.ui.view">
			<field name="name">solse.pe.afectacion.compra.list</field>
			<field name="model">solse.pe.afectacion.compra</field>
			<field name="arch" type="xml">
				<list string="Afectación compra">
					<field name="sequence" widget="handle"/>
					<field name="codigo"/>
					<field name="name"/>
					<field name="categoria"/>
					<field name="aplica_rce" optional="show"/>
					<field name="aplica_rce_no_dom" optional="show"/>
					<field name="active" optional="hide"/>
				</list>
			</field>
		</record>

		<record id="afectacion_compra_search_view" model="ir.ui.view">
			<field name="name">solse.pe.afectacion.compra.search</field>
			<field name="model">solse.pe.afectacion.compra</field>
			<field name="arch" type="xml">
				<search string="Afectación compra">
					<field name="name"/>
					<field name="codigo"/>
					<field name="categoria"/>
					<filter string="Aplica al RCE 8.4" name="filter_rce" domain="[('aplica_rce', '=', True)]"/>
					<filter string="Aplica al RCE 8.5" name="filter_rce_no_dom" domain="[('aplica_rce_no_dom', '=', True)]"/>
					<filter string="Excluidas de libros" name="filter_excluir" domain="[('aplica_rce', '=', False), ('aplica_rce_no_dom', '=', False)]"/>
					<separator/>
					<filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
					<group>
						<filter string="Categoría" name="group_categoria" context="{'group_by': 'categoria'}"/>
					</group>
				</search>
			</field>
		</record>

		<record id="afectacion_compra_act_window" model="ir.actions.act_window">
			<field name="name">Afectación compra</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">solse.pe.afectacion.compra</field>
			<field name="view_mode">list,form</field>
			<field name="help" type="html">
				<p class="oe_view_nocontent_create">
					Crea un nuevo tipo de afectación para compras peruanas.
				</p>
				<p>
					Los tipos de afectación clasifican las líneas de factura para
					que sus montos se distribuyan correctamente en las columnas de
					los libros SIRE (Registro de Compras 8.4 y 8.5).
				</p>
			</field>
		</record>

		<menuitem name="Afectación compra"
			id="pe_afectacion_compra_menu"
			parent="account.account_invoicing_menu"
			action="afectacion_compra_act_window"
			sequence="9"/>

	</data>
</odoo>
