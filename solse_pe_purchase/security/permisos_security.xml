<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">
    <!-- Privilegio -->
    <record id="privilege_purchase_user_my" model="res.groups.privilege">
        <field name="name">Usuario: Mostrar solo documentos propios</field>
        <field name="category_id" ref="base.module_category_purchases"/>
    </record>
    
    <!-- Grupo -->
    <record id="group_purchase_user_my" model="res.groups">
        <field name="name">Usuario: Mostrar solo documentos propios</field>
        <field name="privilege_id" ref="privilege_purchase_user_my"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    
    <!-- Regla -->
    <record model="ir.rule" id="purchase_my_document">
        <field name="name">Solo compras creadas por el usuario</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('solse_pe_purchase.group_purchase_user_my'))]"/>
    </record>
</data>
</odoo>