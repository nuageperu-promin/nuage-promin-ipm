<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_obligaciones">
            <field name="name">Obligaciones financieras</field>
            <field name="description">Control de pagarés, cartas fianza y otras obligaciones</field>
            <field name="sequence">25</field>
        </record>

        <record id="privilege_obl_consulta" model="res.groups.privilege">
            <field name="name">Consulta</field>
            <field name="category_id" ref="module_category_obligaciones"/>
        </record>
        <record id="privilege_obl_tesoreria" model="res.groups.privilege">
            <field name="name">Tesorería</field>
            <field name="category_id" ref="module_category_obligaciones"/>
        </record>
        <record id="privilege_obl_finanzas" model="res.groups.privilege">
            <field name="name">Jefe de Finanzas</field>
            <field name="category_id" ref="module_category_obligaciones"/>
        </record>
        <record id="privilege_obl_contabilidad" model="res.groups.privilege">
            <field name="name">Contabilidad</field>
            <field name="category_id" ref="module_category_obligaciones"/>
        </record>

        <record id="group_obl_consulta" model="res.groups">
            <field name="name">Consulta</field>
            <field name="privilege_id" ref="privilege_obl_consulta"/>
        </record>
        <record id="group_obl_tesoreria" model="res.groups">
            <field name="name">Tesorería (registra y gestiona)</field>
            <field name="privilege_id" ref="privilege_obl_tesoreria"/>
            <field name="implied_ids" eval="[(4, ref('group_obl_consulta'))]"/>
        </record>
        <record id="group_obl_finanzas" model="res.groups">
            <field name="name">Jefe de Finanzas (aprueba)</field>
            <field name="privilege_id" ref="privilege_obl_finanzas"/>
            <field name="implied_ids" eval="[(4, ref('group_obl_tesoreria'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        <record id="group_obl_contabilidad" model="res.groups">
            <field name="name">Contabilidad (asientos y conciliación)</field>
            <field name="privilege_id" ref="privilege_obl_contabilidad"/>
            <field name="implied_ids" eval="[(4, ref('group_obl_consulta')), (4, ref('account.group_account_invoice'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
