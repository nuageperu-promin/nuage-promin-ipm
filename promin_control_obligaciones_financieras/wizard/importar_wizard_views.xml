<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_importar_wizard_form" model="ir.ui.view">
        <field name="name">promin.obligacion.importar.wizard.form</field>
        <field name="model">promin.obligacion.importar.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="obligacion_id"/>
                    <field name="formato"/>
                    <field name="reemplazar"/>
                </group>
                <p class="text-muted">
                    Pegue las filas del cronograma (una por cuota). Formato simple: Fecha, Capital, Interés,
                    Comisión, ITF/otros, separados por tabulación, punto y coma o espacios.
                    Las filas de títulos o totales se ignoran.
                </p>
                <field name="texto" placeholder="16/02/2026&#9;8,197.75&#9;293.80&#9;1.50&#9;0.00"/>
                <footer>
                    <button name="action_importar" string="Cargar cuotas" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
