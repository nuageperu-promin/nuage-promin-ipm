<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_obligaciones" model="ir.ui.view">
        <field name="name">res.company.form.obligaciones</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Obligaciones financieras" name="obligaciones_financieras">
                    <group>
                        <group string="Asientos">
                            <field name="promin_obl_diario_id"/>
                            <field name="promin_obl_cta_interes_id"/>
                            <field name="promin_obl_cta_comision_id"/>
                            <field name="promin_obl_cta_itf_id"/>
                        </group>
                        <group string="Diferencia de cambio y alertas">
                            <field name="promin_obl_cta_dc_ganancia_id"/>
                            <field name="promin_obl_cta_dc_perdida_id"/>
                            <field name="promin_obl_dias_alerta"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
