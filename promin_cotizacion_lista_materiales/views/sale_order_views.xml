<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="promin_sale_order_form_bom" model="ir.ui.view">
        <field name="name">sale.order.form.promin.lista.materiales</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="promin_imprime_bom" readonly="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
