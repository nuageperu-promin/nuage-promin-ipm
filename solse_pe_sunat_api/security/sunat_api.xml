<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría -->
        <record model="ir.module.category" id="module_solse_api_sunat">
            <field name="name">API SUNAT</field>
            <field name="description">Api sunat</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilegios -->
        <record id="privilege_solse_api_sunat_user" model="res.groups.privilege">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_solse_api_sunat"/>
        </record>

        <record id="privilege_solse_api_sunat_manager" model="res.groups.privilege">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_solse_api_sunat"/>
        </record>

        <!-- Grupos -->
        <record id="group_solse_api_sunat_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="privilege_id" ref="privilege_solse_api_sunat_user"/>
        </record>

        <record id="group_solse_api_sunat_manager" model="res.groups">
            <field name="name">Administrador</field>
            <field name="privilege_id" ref="privilege_solse_api_sunat_manager"/>
            <field name="implied_ids" eval="[(4, ref('group_solse_api_sunat_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        </record>
    </data>
</odoo>