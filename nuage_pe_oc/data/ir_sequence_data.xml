<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- El número siguiente se ajusta en Ajustes > Técnico > Secuencias
         (por ejemplo 561 para PMS y 696 para PMI). -->
    <record id="nuage_seq_oc_pma" model="ir.sequence">
        <field name="name">OC Activo (PMA)</field>
        <field name="code">nuage.oc.pma</field>
        <field name="prefix">PMA-</field>
        <field name="padding">7</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
