<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="plame_wizard_view_form" model="ir.ui.view">
		<field name="name">solse.payroll.plame.wizard.form</field>
		<field name="model">solse.payroll.plame.wizard</field>
		<field name="arch" type="xml">
			<form>
				<div class="text-muted" style="margin-bottom: 8px;">
					Genera los archivos de importación al PDT PLAME (.rem, .jor, .snl)
					desde las boletas VALIDADAS del periodo. Las aportaciones (06xx/08xx)
					las calcula el propio PDT y no se exportan.
				</div>
				<group>
					<group>
						<field name="mes"/>
						<field name="anio"/>
					</group>
				</group>
				<group invisible="not archivo">
					<field name="archivo" filename="archivo_nombre" readonly="1"/>
					<field name="archivo_nombre" invisible="1"/>
					<field name="resumen"/>
				</group>
				<footer>
					<button name="action_generar" string="Generar archivos PLAME" type="object" class="btn-primary"/>
					<button string="Cerrar" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="action_plame_wizard" model="ir.actions.act_window">
		<field name="name">PLAME - Archivos PDT</field>
		<field name="res_model">solse.payroll.plame.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>

	<menuitem id="menu_pe_plame" parent="menu_solse_pe_payroll_root"
			  name="PLAME (archivos PDT)" action="action_plame_wizard"
			  sequence="32"/>
</odoo>
