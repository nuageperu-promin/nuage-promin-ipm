<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================
             TIPOS DE ESTRUCTURA SALARIAL
             noupdate=1: el cliente puede personalizar nombres sin que se
             sobreescriban al actualizar el módulo.
        ================================================================ -->

        <!-- Tipo: Régimen General (mensual) -->
        <record id="hr_payroll_structure_type_regimen_general" model="hr.payroll.structure.type">
            <field name="name">Régimen General</field>
            <field name="country_id" ref="base.pe"/>
            <field name="default_schedule_pay">monthly</field>
            <field name="wage_type">monthly</field>
            <field name="sequence">10</field>
        </record>

        <!-- Tipo: Obreros / Semanal -->
        <record id="hr_payroll_structure_type_semanal" model="hr.payroll.structure.type">
            <field name="name">Obreros - Semanal</field>
            <field name="country_id" ref="base.pe"/>
            <field name="default_schedule_pay">weekly</field>
            <field name="wage_type">monthly</field>
            <field name="sequence">20</field>
        </record>

        <!-- Tipo: Quincenal / Adelanto -->
        <record id="hr_payroll_structure_type_quincenal" model="hr.payroll.structure.type">
            <field name="name">Quincenal - Adelanto</field>
            <field name="country_id" ref="base.pe"/>
            <field name="default_schedule_pay">semi-monthly</field>
            <field name="wage_type">monthly</field>
            <field name="sequence">30</field>
        </record>

        <!-- Tipo: Beneficios Sociales (gratif, CTS, vacaciones, liquidación) -->
        <record id="hr_payroll_structure_type_beneficios" model="hr.payroll.structure.type">
            <field name="name">Beneficios Sociales</field>
            <field name="country_id" ref="base.pe"/>
            <field name="default_schedule_pay">monthly</field>
            <field name="wage_type">monthly</field>
            <field name="sequence">40</field>
        </record>

        <!-- ================================================================
             ESTRUCTURAS SALARIALES
             Las reglas se inyectan vía post_init_hook (inicializar_estructuras.py)
             para no duplicar 91 reglas × 7 estructuras en XML.
        ================================================================ -->

        <!-- 1. Nómina Mensual Empleados -->
        <record id="hr_payroll_structure_mensual_empleados" model="hr.payroll.structure">
            <field name="name">Nómina Mensual Empleados</field>
            <field name="code">NME</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_regimen_general"/>
            <field name="rule_ids" eval="[]"/>
        </record>

        <!-- Marcar la estructura principal del tipo se hace en el post_init_hook -->

        <!-- 2. Nómina Semanal Obreros -->
        <record id="hr_payroll_structure_semanal_obreros" model="hr.payroll.structure">
            <field name="name">Nómina Semanal Obreros</field>
            <field name="code">NSO</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_semanal"/>
            <field name="rule_ids" eval="[]"/>
        </record>

        <!-- 3. Nómina Quincenal / Adelanto -->
        <record id="hr_payroll_structure_quincenal_adelanto" model="hr.payroll.structure">
            <field name="name">Nómina Quincenal / Adelanto</field>
            <field name="code">NQA</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_quincenal"/>
            <field name="rule_ids" eval="[]"/>
        </record>

        <!-- 4. Gratificaciones -->
        <record id="hr_payroll_structure_gratificaciones" model="hr.payroll.structure">
            <field name="name">Gratificaciones</field>
            <field name="code">GRAT</field>
            <field name="payslip_name">Boleta de Gratificación</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_beneficios"/>
            <field name="rule_ids" eval="[]"/>
        </record>

        <!-- 5. CTS -->
        <record id="hr_payroll_structure_cts" model="hr.payroll.structure">
            <field name="name">CTS</field>
            <field name="code">CTS</field>
            <field name="payslip_name">Liquidación CTS</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_beneficios"/>
            <field name="rule_ids" eval="[]"/>
        </record>

        <!-- 6. Vacaciones -->
        <record id="hr_payroll_structure_vacaciones" model="hr.payroll.structure">
            <field name="name">Vacaciones</field>
            <field name="code">VAC</field>
            <field name="payslip_name">Boleta de Vacaciones</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_beneficios"/>
            <field name="rule_ids" eval="[]"/>
        </record>

        <!-- 7. Liquidación -->
        <record id="hr_payroll_structure_liquidacion" model="hr.payroll.structure">
            <field name="name">Liquidación</field>
            <field name="code">LIQ</field>
            <field name="payslip_name">Liquidación de Beneficios</field>
            <field name="country_id" ref="base.pe"/>
            <field name="type_id" ref="solse_pe_payroll.hr_payroll_structure_type_beneficios"/>
            <field name="rule_ids" eval="[]"/>
        </record>

    </data>
</odoo>
