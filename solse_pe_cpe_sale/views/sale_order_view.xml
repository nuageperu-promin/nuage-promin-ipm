        <record id="view_order_form_sale_cpe" model="ir.ui.view">
            <field name="name">sale.order.form.cpe.sale</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!--se cambia de vista tree a list-->
                <xpath expr="//field[@name='order_line']//list//field[@name='tax_ids']" position="before">
                    <field name="pe_affectation_code" optional="hide"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/form//field[@name='tax_ids']" position="before">
                    <field name="pe_affectation_code"/>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="domain">[('type', '=', 'contact')]</attribute>
                </xpath>

                <!--<xpath expr="//field[@name='payment_term_id']" position="before">
                    <field name="diario"/>
                </xpath>-->
                
            </field>
        </record>

