<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="promin_res_partner_form_bloqueo" model="ir.ui.view">
        <field name="name">res.partner.form.promin.bloqueo.credito</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='credit_limit']/ancestor::group[1]" position="inside">
                <field name="currency_id" invisible="1"/>
                <field name="promin_bloquear_venta"/>
                <field name="promin_limite_compras" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="promin_bloquear_compra"/>
            </xpath>
        </field>
    </record>
</odoo>
