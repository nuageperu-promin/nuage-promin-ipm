<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nuage_retencion_company_rule" model="ir.rule">
        <field name="name">Comprobante de retención: multicompañía</field>
        <field name="model_id" ref="model_nuage_retencion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="nuage_retencion_line_company_rule" model="ir.rule">
        <field name="name">Línea de retención: multicompañía</field>
        <field name="model_id" ref="model_nuage_retencion_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
