<odoo>
  <data>
    <!-- explicit list view definition -->
    <!-- Se cambio la vista tree por list para v18-->
    <record id="view_pe_certificate_tree" model="ir.ui.view">
      <field name="name">cpe.certificate.list</field>
      <field name="model">cpe.certificate</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="start_date" />
          <field name="end_date" />
        </list>
      </field>
    </record>

    <record id="view_pe_certificate_from" model="ir.ui.view">
      <field name="name">cpe.certificate.form</field>
      <field name="model">cpe.certificate</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_draft" string="Borrador" invisible="state != 'cancel'" type="object" />
            <button name="action_done" string="Hecho" invisible="state != 'draft'" type="object" />
            <button name="action_cancel" string="Cancelado" invisible="state != 'done'" type="object" />
            <field name="state" widget="statusbar" statusbar_visible="draft,done" />
          </header>
          <group>
            <group>
              <field name="company_id" />
              <field name="name" />
            </group>
            <group>
              <field name="start_date" />
              <field name="end_date" />
            </group>
          </group>
          <label for="key" />
          <field name="key" />
          <label for="crt" />
          <field name="crt" />
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="action_pe_certificate">
      <field name="name">Certificados SUNAT</field>
      <field name="res_model">cpe.certificate</field>
      <field name="view_mode">list,form</field>
    </record>

  </data>
</odoo>