<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="promin_sale_order_form_version" model="ir.ui.view">
        <field name="name">sale.order.form.promin.versionado</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(promin_versionado_cotizaciones.promin_nueva_version_action)d" type="action"
                        string="Nueva versión"
                        invisible="state not in ('draft', 'sent') or version_historica"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="version_historica" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="not version_historica">
                    Versión anterior, solo de consulta.
                    <button name="action_abrir_version_vigente" type="object"
                            class="btn btn-link p-0 align-baseline" string="Abrir la versión vigente"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ver_versiones" type="object" class="oe_stat_button"
                        icon="fa-files-o" invisible="version_total &lt;= 1">
                    <field name="version_total" widget="statinfo" string="Versiones"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="version_numero" invisible="version_numero &lt;= 1"/>
                <field name="version_anterior_id" invisible="not version_anterior_id"/>
                <field name="version_motivo" invisible="not version_motivo"/>
            </xpath>
        </field>
    </record>

    <record id="promin_sale_order_search_version" model="ir.ui.view">
        <field name="name">sale.order.search.promin.versionado</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Solo versiones vigentes" name="promin_version_vigente"
                        domain="[('version_historica', '=', False)]"/>
                <filter string="Versiones anteriores" name="promin_version_historica"
                        domain="[('version_historica', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
