<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Privilegios ocultos para configuraciones técnicas -->
        <record id="privilege_plate_invoice" model="res.groups.privilege">
            <field name="name">Plate in Invoice/Sale</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="privilege_plate_invoice_line" model="res.groups.privilege">
            <field name="name">Plate in Invoice/Sale Line</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!-- Grupos vinculados a los privilegios -->
        <record id="group_plate_invoice" model="res.groups">
            <field name="name">Placa en Factura/Venta</field>
            <field name="privilege_id" ref="privilege_plate_invoice"/>
        </record>

        <record id="group_plate_invoice_line" model="res.groups">
            <field name="name">Placa en Línea de Factura/Venta</field>
            <field name="privilege_id" ref="privilege_plate_invoice_line"/>
        </record>

        <!-- Regla de registro (sin cambios) -->
        <record id="tipo_comprobante_rule" model="ir.rule">
            <field name="name">Tipo y series para comprobantes</field>
            <field name="model_id" ref="model_l10n_latam_document_type"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        </record>
    </data>
</odoo>