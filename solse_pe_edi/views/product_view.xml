<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de UoM - Campo rounding eliminado en Odoo 19 -->
    <record model="ir.ui.view" id="product_uom_form_view">
        <field name="model">uom.uom</field>
        <field name="name">uom.uom.form.inherit</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <!-- Buscar otro campo de referencia válido en Odoo 19 -->
            <field name="name" position="after">
                <field name="sunat_code"/>
            </field>
        </field>
    </record>
    
    <record id="view_category_property_form" model="ir.ui.view">
        <field name="name">product.category.property.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <group name="first" position="after">
                <group name="peruvian_localization" string="Localización Peruana">
                    <group>
                        <field name="pe_code"/>
                        <field name="pe_type"/>
                        <field name="l10n_pe_valuation_method_id"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_form_pe_stock" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="pe_code_osce"/>
                <field name="aplica_detraccion"/>
                <field name="porc_detraccion" invisible="not aplica_detraccion"/>
            </field>
        </field>
    </record>
</odoo>