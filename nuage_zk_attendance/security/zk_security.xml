<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zk_device_company_rule" model="ir.rule">
        <field name="name">Reloj ZKTeco: multicompañía</field>
        <field name="model_id" ref="model_zk_device"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="zk_attendance_log_company_rule" model="ir.rule">
        <field name="name">Marcación ZKTeco: multicompañía</field>
        <field name="model_id" ref="model_zk_attendance_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
