<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zk_attendance_log_view_list" model="ir.ui.view">
        <field name="name">zk.attendance.log.list</field>
        <field name="model">zk.attendance.log</field>
        <field name="arch" type="xml">
            <list string="Marcaciones del reloj" create="0" edit="0"
                  decoration-success="state == 'processed'"
                  decoration-warning="state in ('review', 'no_employee')"
                  decoration-danger="state == 'error'"
                  decoration-muted="state in ('duplicate', 'ignored')">
                <field name="punch_datetime"/>
                <field name="device_id"/>
                <field name="pin"/>
                <field name="employee_id"/>
                <field name="action" optional="show"/>
                <field name="status_code" optional="hide"/>
                <field name="verify_type" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="zk_attendance_log_view_form" model="ir.ui.view">
        <field name="name">zk.attendance.log.form</field>
        <field name="model">zk.attendance.log</field>
        <field name="arch" type="xml">
            <form string="Marcación del reloj" create="0" edit="0">
                <header>
                    <button name="action_reprocess" type="object" string="Reprocesar"
                            class="btn-primary"
                            invisible="state in ('processed', 'duplicate')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="pin"/>
                            <field name="punch_datetime"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="attendance_id"/>
                            <field name="status_code"/>
                            <field name="verify_type"/>
                            <field name="workcode"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="raw_line"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zk_attendance_log_view_search" model="ir.ui.view">
        <field name="name">zk.attendance.log.search</field>
        <field name="model">zk.attendance.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="pin"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <filter name="to_check" string="Requieren atención"
                        domain="[('state', 'in', ('review', 'no_employee', 'error', 'pending'))]"/>
                <filter name="no_employee" string="Sin empleado" domain="[('state', '=', 'no_employee')]"/>
                <filter name="review" string="Revisar" domain="[('state', '=', 'review')]"/>
                <filter name="error" string="Error" domain="[('state', '=', 'error')]"/>
                <filter name="processed" string="Procesadas" domain="[('state', '=', 'processed')]"/>
                <group>
                    <filter name="group_device" string="Reloj" context="{'group_by': 'device_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_day" string="Día" context="{'group_by': 'punch_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zk_attendance_log_action" model="ir.actions.act_window">
        <field name="name">Marcaciones del reloj</field>
        <field name="res_model">zk.attendance.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_check': 1}</field>
    </record>

    <record id="zk_attendance_log_reprocess_action" model="ir.actions.server">
        <field name="name">Reprocesar</field>
        <field name="model_id" ref="model_zk_attendance_log"/>
        <field name="binding_model_id" ref="model_zk_attendance_log"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_reprocess()</field>
    </record>
</odoo>
