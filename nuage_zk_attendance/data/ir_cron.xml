<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_zk_process_pending" model="ir.cron">
            <field name="name">Relojes ZKTeco: procesar marcaciones pendientes</field>
            <field name="model_id" ref="model_zk_attendance_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="ir_cron_zk_check_offline" model="ir.cron">
            <field name="name">Relojes ZKTeco: avisar relojes sin conexión</field>
            <field name="model_id" ref="model_zk_device"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_offline()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
        </record>
    </data>
</odoo>
