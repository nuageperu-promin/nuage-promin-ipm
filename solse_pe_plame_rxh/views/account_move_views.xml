<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_move_form_plame" model="ir.ui.view">
		<field name="name">account.move.form.plame.rxh</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<field name="payment_reference" position="after">
				<field name="es_recibo_honorarios" invisible="1"/>
				<field name="plame_tipo_comprobante"
				       invisible="move_type not in ('in_invoice', 'in_refund')"
				       placeholder="Automático (R / N)"/>
			</field>
		</field>
	</record>

</odoo>
