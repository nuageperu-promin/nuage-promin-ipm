<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_plame_rxh_exportar_form" model="ir.ui.view">
		<field name="name">plame.rxh.exportar.form</field>
		<field name="model">plame.rxh.exportar</field>
		<field name="arch" type="xml">
			<form string="Exportar recibos por honorarios al PLAME">
				<group>
					<group>
						<field name="company_id" groups="base.group_multi_company"
						       options="{'no_create': True}"/>
						<field name="ejercicio"/>
						<field name="mes"/>
					</group>
					<group>
						<field name="fecha_inicio"/>
						<field name="fecha_fin"/>
						<field name="estado" invisible="1"/>
						<field name="hay_errores" invisible="1"/>
						<field name="currency_id" invisible="1"/>
					</group>
				</group>

				<div class="alert alert-info" role="status" invisible="estado == 'listo'">
					Entran al periodo los recibos cuyo <b>pago</b> se produjo entre
					las fechas indicadas, sin importar su fecha de emisión.
				</div>

				<group invisible="not cantidad_comprobantes">
					<group>
						<field name="cantidad_prestadores"/>
						<field name="cantidad_comprobantes"/>
					</group>
					<group>
						<field name="total_declarado"/>
					</group>
				</group>

				<notebook invisible="not resumen">
					<page string="Comprobantes" name="comprobantes"
					      invisible="not cantidad_comprobantes">
						<field name="linea_ids" nolabel="1">
							<list create="false" delete="false" edit="false">
								<field name="numero_documento"/>
								<field name="partner_id"/>
								<field name="tipo_comprobante"/>
								<field name="serie"/>
								<field name="numero"/>
								<field name="fecha_emision"/>
								<field name="fecha_pago"/>
								<field name="retencion" widget="boolean_toggle"/>
								<field name="monto" sum="Total"/>
								<field name="move_id"/>
							</list>
						</field>
					</page>
					<page string="Validaciones" name="validaciones">
						<field name="resumen" nolabel="1" readonly="1"/>
					</page>
				</notebook>

				<group string="Archivos generados" invisible="estado != 'listo'">
					<field name="archivo_ps4" filename="nombre_ps4" readonly="1"/>
					<field name="nombre_ps4" invisible="1"/>
					<field name="archivo_4ta" filename="nombre_4ta" readonly="1"/>
					<field name="nombre_4ta" invisible="1"/>
				</group>
				<div class="alert alert-warning" role="alert" invisible="estado != 'listo'">
					Importe primero el archivo <b>.ps4</b> (prestadores) y luego el
					<b>.4ta</b> (comprobantes), desde
					<i>Detalle de Declaración / PS 4ta Categoría</i> del PDT PLAME.
				</div>

				<footer>
					<button name="action_revisar" type="object" string="Revisar periodo"
					        class="btn-secondary"/>
					<button name="action_generar" type="object" string="Generar archivos"
					        class="btn-primary"/>
					<button string="Cerrar" class="btn-secondary" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

	<record id="action_plame_rxh_exportar" model="ir.actions.act_window">
		<field name="name">PLAME - Recibos por Honorarios</field>
		<field name="res_model">plame.rxh.exportar</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>

</odoo>
